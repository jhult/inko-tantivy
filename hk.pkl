amends "package://github.com/jdx/hk/releases/download/v1.36.0/hk@1.36.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.36.0/hk@1.36.0#/Builtins.pkl"

local linters = new Mapping<String, Step> {
    ["inko-fmt"] {
        glob = "*.inko"
        check = "inko fmt --check {{files}}"
        fix = "inko fmt {{files}}"
    }
    ["license-eye"] {
        check = "license-eye header check {{files}}"
        fix = "license-eye header fix {{files}}"
    }
}

local hooks = new Mapping<String, Step> {
    ["pre-commit"] {
        steps {
            ["inko-fmt"] = linters["inko-fmt"]
            ["license-eye"] = linters["license-eye"]
        }
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = linters
    }
}
