amends "package://github.com/jdx/hk/releases/download/v1.36.0/hk@1.36.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.36.0/hk@1.36.0#/Builtins.pkl"

local linters = new Mapping<String, Step> {
    ["bd-sync"] {
        check = "bd sync --flush-only"
    }
    ["inko-fmt"] {
        glob = "*.inko"
        check = "inko fmt --check {{files}}"
        fix = "inko fmt {{files}}"
    }
    ["license-eye"] {
        check = "license-eye header check {{files}}"
        fix = "license-eye header fix {{files}}"
    }
}

local bdHooks = new Mapping<String, Step> {
    ["bd-post-checkout"] {
        check = "bd hook post-checkout"
    }
    ["bd-post-merge"] {
        check = "bd hook post-merge"
    }
    ["bd-pre-push"] {
        check = "bd hooks run pre-push"
    }
    ["bd-prepare-commit-msg"] {
        check = "bd hooks run prepare-commit-msg"
    }
}

hooks {
    ["pre-commit"] {
        steps {
            ["bd-sync"] = linters["bd-sync"]
            ["inko-fmt"] = linters["inko-fmt"]
            ["license-eye"] = linters["license-eye"]
        }
    }
    ["post-checkout"] {
        steps {
            ["bd-post-checkout"] = bdHooks["bd-post-checkout"]
        }
    }
    ["post-merge"] {
        steps {
            ["bd-post-merge"] = bdHooks["bd-post-merge"]
        }
    }
    ["pre-push"] {
        steps {
            ["bd-pre-push"] = bdHooks["bd-pre-push"]
        }
    }
    ["prepare-commit-msg"] {
        steps {
            ["bd-prepare-commit-msg"] = bdHooks["bd-prepare-commit-msg"]
        }
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = linters
    }
}
