# Tantivy FFI bindings
#
# This module contains all FFI function declarations and C struct layout constants.
# The struct layout constants are auto-generated from Rust code by build.rs
#
# Default buffer size for reading JSON from Tantivy
# Increased to 1MB to handle large documents with many fields
# If documents exceed this size, an error will be returned
let pub DEFAULT_JSON_BUFFER_SIZE = 1_048_576 # 1MB

# Default buffer size for reading individual string fields (doc IDs, highlights, etc.)
# 4KB should be sufficient for most fields while preventing excessive truncation
let pub DEFAULT_STRING_FIELD_BUFFER_SIZE = 4096 # 4KB

# Buffer size for error messages from Rust
# 1KB should be sufficient for most error messages
let pub TANTIVY_ERROR_BUFFER_SIZE = 1024 # 1KB

# FFI Struct layout constants (64-bit architecture)
# These are auto-generated from Rust struct definitions in native/tantivy-c/src/lib.rs
# Single source of truth - Rust definitions with #[repr(C)] and offset_of! macros

# Pointer size on 64-bit systems (all pointers are 8 bytes)
let pub PTR_SIZE = 8

# Config struct (40 bytes total):
# - index_path pointer (8 bytes)
# - reader_memory_budget_bytes pointer (8 bytes)
# - writer_memory_budget_bytes pointer (8 bytes)
# - num_threads pointer (8 bytes)
# - schema_json pointer (8 bytes)
let pub CONFIG_SIZE = 40
let pub CONFIG_OFFSET_PATH = 0
let pub CONFIG_OFFSET_READER_MEMORY = 8
let pub CONFIG_OFFSET_WRITER_MEMORY = 16
let pub CONFIG_OFFSET_THREADS = 24
let pub CONFIG_OFFSET_SCHEMA_JSON = 32

# Result struct (24 bytes total):
# - doc_id pointer (8 bytes)
# - score pointer (8 bytes)
# - highlight pointer (8 bytes)
let pub RESULT_SIZE = 24
let pub RESULT_OFFSET_DOC_ID = 0
let pub RESULT_OFFSET_SCORE = 8
let pub RESULT_OFFSET_HIGHLIGHT = 16

# AggregationResult struct (16 bytes total):
# - key pointer (8 bytes)
# - count pointer (8 bytes)
let pub AGGREGATION_SIZE = 16
let pub AGGREGATION_OFFSET_KEY = 0
let pub AGGREGATION_OFFSET_COUNT = 8

# Suggestion struct (16 bytes total):
# - text pointer (8 bytes)
# - score pointer (8 bytes)
let pub SUGGESTION_SIZE = 16
let pub SUGGESTION_OFFSET_TEXT = 0
let pub SUGGESTION_OFFSET_SCORE = 8

# Field struct (16 bytes total):
# - key pointer (8 bytes)
# - value pointer (8 bytes)
let pub FIELD_SIZE = 16
let pub FIELD_OFFSET_KEY = 0
let pub FIELD_OFFSET_VALUE = 8

# BatchDocument struct (24 bytes total):
# - doc_id pointer (8 bytes)
# - fields pointer (8 bytes)
# - num_fields pointer (8 bytes)
let pub BATCH_DOCUMENT_SIZE = 24
let pub BATCH_DOCUMENT_OFFSET_DOC_ID = 0
let pub BATCH_DOCUMENT_OFFSET_FIELDS = 8
let pub BATCH_DOCUMENT_OFFSET_NUM_FIELDS = 16

# Link to Tantivy C library
import extern "tantivy_c"

# External FFI functions from the Tantivy C library

# Simple ping function to check if FFI library is loaded
fn pub extern tantivy_ping -> Int

fn pub extern tantivy_index_open(
  config: Pointer[Uint8],
  error_out: Pointer[Uint8],
) -> Pointer[Uint8]

fn pub extern tantivy_index_close(
  index: Pointer[Uint8],
  error_out: Pointer[Uint8],
) -> Int32

fn pub extern tantivy_index_add_doc(
  index: Pointer[Uint8],
  doc_id: Pointer[Uint8],
  fields: Pointer[Uint8],
  num_fields: Int64,
  error_out: Pointer[Uint8],
) -> Int32

fn pub extern tantivy_index_add_docs_batch(
  index: Pointer[Uint8],
  documents: Pointer[Uint8],
  num_docs: Int64,
  error_out: Pointer[Uint8],
) -> Int32

fn pub extern tantivy_index_delete_doc(
  index: Pointer[Uint8],
  doc_id: Pointer[Uint8],
  error_out: Pointer[Uint8],
) -> Int32

fn pub extern tantivy_index_delete_docs(
  index: Pointer[Uint8],
  doc_ids: Pointer[Uint8],
  num_ids: Int64,
  error_out: Pointer[Uint8],
) -> Int32

fn pub extern tantivy_index_search(
  index: Pointer[Uint8],
  query: Pointer[Uint8],
  limit: Int64,
  offset: Int64,
  results_out: Pointer[Uint8],
  num_results_out: Pointer[Uint64],
  error_out: Pointer[Uint8],
) -> Int32

fn pub extern tantivy_index_commit(
  index: Pointer[Uint8],
  error_out: Pointer[Uint8],
) -> Int32

fn pub extern tantivy_index_rollback(
  index: Pointer[Uint8],
  error_out: Pointer[Uint8],
) -> Int32

fn pub extern tantivy_result_free(results: Pointer[Uint8], num_results: Int64)

fn pub extern tantivy_error_free(error: Pointer[Uint8])

fn pub extern tantivy_index_get_doc(
  index: Pointer[Uint8],
  doc_id: Pointer[Uint8],
  error_out: Pointer[Uint8],
) -> Pointer[Uint8]

fn pub extern tantivy_string_free(s: Pointer[Uint8])

fn pub extern tantivy_index_get_docs(
  index: Pointer[Uint8],
  doc_ids: Pointer[Uint8],
  num_ids: Int64,
  num_results_out: Pointer[Uint64],
  error_out: Pointer[Uint8],
) -> Pointer[Uint8]

fn pub extern tantivy_docs_array_free(docs: Pointer[Uint8], num_docs: Int64)

fn pub extern tantivy_aggregate_terms(
  index: Pointer[Uint8],
  field_name: Pointer[Uint8],
  query: Pointer[Uint8],
  limit: Int64,
  results_out: Pointer[Uint8],
  num_results_out: Pointer[Uint64],
  error_out: Pointer[Uint8],
) -> Int32

fn pub extern tantivy_aggregation_results_free(
  results: Pointer[Uint8],
  num_results: Int64,
)

fn pub extern tantivy_autocomplete(
  index: Pointer[Uint8],
  field: Pointer[Uint8],
  prefix: Pointer[Uint8],
  limit: Int64,
  results_out: Pointer[Uint8],
  num_results_out: Pointer[Uint64],
  error_out: Pointer[Uint8],
) -> Int32

fn pub extern tantivy_did_you_mean(
  index: Pointer[Uint8],
  field: Pointer[Uint8],
  term: Pointer[Uint8],
  distance: Int32,
  limit: Int64,
  results_out: Pointer[Uint8],
  num_results_out: Pointer[Uint64],
  error_out: Pointer[Uint8],
) -> Int32

fn pub extern tantivy_suggestions_free(
  results: Pointer[Uint8],
  num_results: Int64,
)
