# Tantivy index manager
#
# This module provides the main business logic for managing Tantivy search indexes,
# including opening/closing indexes, adding/deleting documents, searching, and
# performing aggregations.

import input_validation (
  validate_distance, validate_field_name, validate_limit, validate_offset,
  validate_query,
)
import pointer_helpers (
  is_null, pointer_offset, pointer_to_int, read_usize, write_usize,
)
import std.bytes (ByteArray)
import std.drop (Drop)
import std.fs.path (Path)
import std.stdio (Stderr)
import tantivy.ffi (
  AGGREGATION_OFFSET_COUNT, AGGREGATION_OFFSET_KEY, AGGREGATION_SIZE,
  CONFIG_OFFSET_READER_MEMORY, CONFIG_OFFSET_SCHEMA_JSON, CONFIG_OFFSET_THREADS,
  CONFIG_OFFSET_WRITER_MEMORY, CONFIG_SIZE, DEFAULT_JSON_BUFFER_SIZE,
  DEFAULT_STRING_FIELD_BUFFER_SIZE, FIELD_SIZE, PTR_SIZE, RESULT_OFFSET_DOC_ID,
  RESULT_OFFSET_HIGHLIGHT, RESULT_OFFSET_SCORE, RESULT_SIZE,
  SUGGESTION_OFFSET_SCORE, SUGGESTION_OFFSET_TEXT, SUGGESTION_SIZE,
  tantivy_aggregate_terms, tantivy_aggregation_results_free,
  tantivy_autocomplete, tantivy_did_you_mean, tantivy_docs_array_free,
  tantivy_index_add_doc, tantivy_index_add_docs_batch, tantivy_index_close,
  tantivy_index_commit, tantivy_index_delete_doc, tantivy_index_delete_docs,
  tantivy_index_get_doc, tantivy_index_get_docs, tantivy_index_open,
  tantivy_index_rollback, tantivy_index_search, tantivy_ping,
  tantivy_result_free, tantivy_string_free, tantivy_suggestions_free,
)
import tantivy.marshal (
  allocate_error_output, c_array_element_ptr, c_pointer_to_string_checked,
  check_ffi_error, create_field_array, read_optional_string_field,
  read_string_field, release_string_buffer, string_array_to_c_pointers,
  string_to_c_buffer,
)

# Tantivy search result (Inko-side representation)
#
# # Score Precision
# The `score` field is stored as a Float (f64) in Inko, but the underlying
# Tantivy library uses f32 for scoring. The conversion from f32 to f64 does not add
# precision - it merely stores the same f32 value in a larger container.
#
# # Why f32 in Tantivy?
# Tantivy uses f32 for scores to reduce memory usage and improve performance.
# This is standard practice in search engines (e.g., Elasticsearch, Lucene).
#
# # Practical Implications
# - Scores should not be used for exact comparisons (e.g., `score_a == score_b`)
# - Small differences (< 1e-7) are likely due to f32 rounding
# - Use scores for ranking/sorting, not precise calculations
# - When displaying scores, round to reasonable precision (e.g., 4-6 decimal places)
type pub TantivyResult {
  let pub @doc_id: String
  let pub @score: Float
  let pub @highlight: Option[String]
}

# Tantivy aggregation result
type pub TantivyAggregationResult {
  let pub @key: String
  let pub @count: Int
}

# Tantivy suggestion result
#
# # Score Precision
# The `score` field uses Float (f64) in Inko but is f32 precision from Tantivy.
# See TantivyResult type for detailed documentation about score precision.
type pub TantivySuggestion {
  let pub @text: String
  let pub @score: Float
}

# Tantivy index configuration
#
# Configures memory budgets and threading for the search index.
#
# ## Memory Budgets
# - `reader_memory_budget_bytes`: Memory allocated for search operations
#   - Default: 50MB (suitable for small-to-medium indexes)
#   - Increase for: Large indexes (>1GB), high query throughput
#   - Trade-off: More memory = faster searches, fewer disk reads
#
# - `writer_memory_budget_bytes`: Memory for indexing operations
#   - Default: 100MB (handles typical document batches)
#   - Increase for: Large documents, high indexing throughput
#   - Trade-off: More memory = faster indexing, larger in-memory buffer
#
# ## Threading
# - `num_threads`: Parallel search/indexing threads
#   - Default: 4 (balanced for multi-core systems)
#   - Adjust for: Match available CPU cores
#   - Trade-off: More threads = higher throughput, more CPU usage
#
# ## Tuning Guidelines
# - Small indexes (<100MB): Default settings sufficient
# - Medium indexes (100MB-1GB): Consider 2x memory budgets
# - Large indexes (>1GB): 4-8x memory, match threads to CPU cores
# - Memory-constrained: Reduce budgets to 25MB reader / 50MB writer
# - High throughput: Increase writer memory, add more threads
type pub TantivyConfig {
  let pub @index_path: String
  let pub @reader_memory_budget_bytes: Int
  let pub @writer_memory_budget_bytes: Int
  let pub @num_threads: Int
  let pub @schema_json: Option[String]
  let @json_buffer_size: Int
  let @string_buffer_size: Int
}

impl TantivyConfig {
  # Create a new configuration with default settings
  #
  # Defaults are optimized for small-to-medium indexes on typical hardware:
  # - Reader memory: 50MB (sufficient for most search operations)
  # - Writer memory: 100MB (handles typical document batches)
  # - Threads: 4 (balanced for multi-core systems)
  # - Schema: NULL (use default email schema)
  # - JSON buffer: 1MB (handles large documents)
  # - String buffer: 4KB (sufficient for most fields)
  #
  # Use `with_*` methods to customize for your workload.
  fn pub static new(index_path: String) -> Result[TantivyConfig, String] {
    let reader_memory = 50_000_000
    let writer_memory = 100_000_000
    let num_threads = 4
    let json_buffer_size = DEFAULT_JSON_BUFFER_SIZE
    let string_buffer_size = DEFAULT_STRING_FIELD_BUFFER_SIZE

    match TantivyConfig.validate_index_path(index_path) {
      case Ok(_) -> {}
      case Error(e) -> return Result.Error(e)
    }

    match TantivyConfig.validate_reader_memory(reader_memory) {
      case Ok(_) -> {}
      case Error(e) -> return Result.Error(e)
    }

    match TantivyConfig.validate_writer_memory(writer_memory) {
      case Ok(_) -> {}
      case Error(e) -> return Result.Error(e)
    }

    match TantivyConfig.validate_num_threads(num_threads) {
      case Ok(_) -> {}
      case Error(e) -> return Result.Error(e)
    }

    match TantivyConfig.validate_json_buffer_size(json_buffer_size) {
      case Ok(_) -> {}
      case Error(e) -> return Result.Error(e)
    }

    match TantivyConfig.validate_string_buffer_size(string_buffer_size) {
      case Ok(_) -> {}
      case Error(e) -> return Result.Error(e)
    }

    Result.Ok(
      TantivyConfig(
        index_path: index_path,
        reader_memory_budget_bytes: reader_memory,
        writer_memory_budget_bytes: writer_memory,
        num_threads: num_threads,
        schema_json: Option.None,
        json_buffer_size: json_buffer_size,
        string_buffer_size: string_buffer_size,
      ),
    )
  }

  # Set custom schema JSON configuration
  #
  # The schema JSON format:
  # ```json
  # {
  #   "fields": [
  #     {"name": "title", "type": "text", "indexed": true, "stored": true},
  #     {"name": "content", "type": "text", "indexed": true, "stored": true},
  #     {"name": "timestamp", "type": "u64", "indexed": true, "stored": true}
  #   ],
  #   "default_search_fields": ["title", "content"]
  # }
  # ```
  #
  # Supported field types: "text", "string", "u64", "i64", "f64", "bool"
  # - text: Full-text searchable with tokenization
  # - string: Exact match without tokenization
  # - u64/i64/f64: Numeric fields for range queries
  # - bool: Boolean fields for filtering
  #
  # If not provided, a default email schema is used with fields:
  # - id, account_id, mailbox, message_id (strings)
  # - subject, body (text, searchable)
  # - from, to, cc (strings)
  # - date, size (u64, indexed)
  # - flags, labels, attachments, thread_id, in_reply_to, references (strings)
  fn pub with_schema_json(schema: String) -> Result[TantivyConfig, String] {
    Result.Ok(
      TantivyConfig(
        index_path: @index_path.clone,
        reader_memory_budget_bytes: @reader_memory_budget_bytes,
        writer_memory_budget_bytes: @writer_memory_budget_bytes,
        num_threads: @num_threads,
        schema_json: Option.Some(schema),
        json_buffer_size: @json_buffer_size,
        string_buffer_size: @string_buffer_size,
      ),
    )
  }

  # Validate index path to prevent directory traversal attacks
  fn pub static validate_index_path(path: String) -> Result[Bool, String] {
    if path.size == 0 { return Result.Error('index_path cannot be empty') }

    let path_obj = Path.new(path)

    # Check for directory traversal components (..)
    # Using Path.components which normalizes the path
    for component in path_obj.components {
      match component {
        case '..' -> {
          return Result.Error(
            'index_path cannot contain ".." (directory traversal not allowed)',
          )
        }
        case _ -> {}
      }
    }

    # Check for suspicious patterns that could indicate path manipulation attempts
    # This helps prevent attacks like URL-encoded variants or obfuscated paths
    if path.contains?('%2e') or path.contains?('%2E') {
      return Result.Error(
        'index_path contains suspicious characters (potential path encoding attack)',
      )
    }

    # Check for multiple consecutive dots which could be an obfuscation attempt
    if path.contains?('...') or path.contains?('....') {
      return Result.Error('index_path contains suspicious dot sequences')
    }

    Result.Ok(true)
  }

  # Validate reader memory budget
  fn pub static validate_reader_memory(bytes: Int) -> Result[Bool, String] {
    if bytes < 10_000_000 {
      return Result.Error(
        'reader_memory_budget_bytes must be at least 10MB (10,000,000 bytes)',
      )
    }

    if bytes > 10_000_000_000 {
      return Result.Error(
        'reader_memory_budget_bytes must be at most 10GB (10,000,000,000 bytes)',
      )
    }

    Result.Ok(true)
  }

  # Validate writer memory budget
  fn pub static validate_writer_memory(bytes: Int) -> Result[Bool, String] {
    if bytes < 25_000_000 {
      return Result.Error(
        'writer_memory_budget_bytes must be at least 25MB (25,000,000 bytes)',
      )
    }

    if bytes > 50_000_000_000 {
      return Result.Error(
        'writer_memory_budget_bytes must be at most 50GB (50,000,000,000 bytes)',
      )
    }

    Result.Ok(true)
  }

  # Validate num_threads
  fn pub static validate_num_threads(n: Int) -> Result[Bool, String] {
    if n < 1 { return Result.Error('num_threads must be at least 1') }

    # Maximum: CPU cores * 2 (assuming max 32 cores for safety)
    if n > 64 {
      return Result.Error('num_threads must be at most 64 (CPU cores * 2)')
    }

    Result.Ok(true)
  }

  fn pub with_reader_memory(bytes: Int) -> Result[TantivyConfig, String] {
    match TantivyConfig.validate_reader_memory(bytes) {
      case Ok(_) -> {}
      case Error(e) -> return Result.Error(e)
    }

    Result.Ok(
      TantivyConfig(
        index_path: @index_path.clone,
        reader_memory_budget_bytes: bytes,
        writer_memory_budget_bytes: @writer_memory_budget_bytes,
        num_threads: @num_threads,
        schema_json: @schema_json.clone,
        json_buffer_size: @json_buffer_size,
        string_buffer_size: @string_buffer_size,
      ),
    )
  }

  fn pub with_writer_memory(bytes: Int) -> Result[TantivyConfig, String] {
    match TantivyConfig.validate_writer_memory(bytes) {
      case Ok(_) -> {}
      case Error(e) -> return Result.Error(e)
    }

    Result.Ok(
      TantivyConfig(
        index_path: @index_path.clone,
        reader_memory_budget_bytes: @reader_memory_budget_bytes,
        writer_memory_budget_bytes: bytes,
        num_threads: @num_threads,
        schema_json: @schema_json.clone,
        json_buffer_size: @json_buffer_size,
        string_buffer_size: @string_buffer_size,
      ),
    )
  }

  fn pub with_threads(n: Int) -> Result[TantivyConfig, String] {
    match TantivyConfig.validate_num_threads(n) {
      case Ok(_) -> {}
      case Error(e) -> return Result.Error(e)
    }

    Result.Ok(
      TantivyConfig(
        index_path: @index_path.clone,
        reader_memory_budget_bytes: @reader_memory_budget_bytes,
        writer_memory_budget_bytes: @writer_memory_budget_bytes,
        num_threads: n,
        schema_json: @schema_json.clone,
        json_buffer_size: @json_buffer_size,
        string_buffer_size: @string_buffer_size,
      ),
    )
  }

  # Validate JSON buffer size
  # Used for reading document JSON from Tantivy
  fn pub static validate_json_buffer_size(bytes: Int) -> Result[Bool, String] {
    if bytes < 1024 {
      return Result.Error('json_buffer_size must be at least 1KB (1,024 bytes)')
    }

    if bytes > 100_000_000 {
      return Result.Error(
        'json_buffer_size must be at most 100MB (100,000,000 bytes)',
      )
    }

    Result.Ok(true)
  }

  # Validate string buffer size
  # Used for reading individual string fields (doc IDs, highlights, etc.)
  fn pub static validate_string_buffer_size(
    bytes: Int,
  ) -> Result[Bool, String] {
    if bytes < 256 {
      return Result.Error('string_buffer_size must be at least 256 bytes')
    }

    if bytes > 1_000_000 {
      return Result.Error(
        'string_buffer_size must be at most 1MB (1,000,000 bytes)',
      )
    }

    Result.Ok(true)
  }

  # Set JSON buffer size
  # Useful for handling large documents or reducing memory footprint
  fn pub with_json_buffer_size(bytes: Int) -> Result[TantivyConfig, String] {
    match TantivyConfig.validate_json_buffer_size(bytes) {
      case Ok(_) -> {}
      case Error(e) -> return Result.Error(e)
    }

    Result.Ok(
      TantivyConfig(
        index_path: @index_path.clone,
        reader_memory_budget_bytes: @reader_memory_budget_bytes,
        writer_memory_budget_bytes: @writer_memory_budget_bytes,
        num_threads: @num_threads,
        schema_json: @schema_json.clone,
        json_buffer_size: bytes,
        string_buffer_size: @string_buffer_size,
      ),
    )
  }

  # Set string buffer size
  # Useful for handling large field values or reducing memory footprint
  fn pub with_string_buffer_size(bytes: Int) -> Result[TantivyConfig, String] {
    match TantivyConfig.validate_string_buffer_size(bytes) {
      case Ok(_) -> {}
      case Error(e) -> return Result.Error(e)
    }

    Result.Ok(
      TantivyConfig(
        index_path: @index_path.clone,
        reader_memory_budget_bytes: @reader_memory_budget_bytes,
        writer_memory_budget_bytes: @writer_memory_budget_bytes,
        num_threads: @num_threads,
        schema_json: @schema_json.clone,
        json_buffer_size: @json_buffer_size,
        string_buffer_size: bytes,
      ),
    )
  }

  # Convert to C struct format (ByteArray for manual memory layout)
  # Returns both the struct and the string buffers that must be kept alive
  # during the FFI call
  fn to_c_struct -> (ByteArray, Array[String]) {
    let buf = ByteArray.filled(with: 0, times: CONFIG_SIZE)
    let mut buffers = []

    let path_buf = string_to_c_buffer(@index_path)

    write_usize(buf.pointer, pointer_to_int(path_buf.pointer))

    buffers.push(path_buf)

    write_usize(
      pointer_offset(buf.pointer, CONFIG_OFFSET_READER_MEMORY),
      @reader_memory_budget_bytes,
    )

    write_usize(
      pointer_offset(buf.pointer, CONFIG_OFFSET_WRITER_MEMORY),
      @writer_memory_budget_bytes,
    )

    write_usize(
      pointer_offset(buf.pointer, CONFIG_OFFSET_THREADS),
      @num_threads,
    )

    match @schema_json {
      case Some(schema) -> {
        let schema_buf = string_to_c_buffer(schema)

        write_usize(
          pointer_offset(buf.pointer, CONFIG_OFFSET_SCHEMA_JSON),
          pointer_to_int(schema_buf.pointer),
        )

        buffers.push(schema_buf)
      }
      case None -> {
        # schema_json is NULL (0) to use default email schema
        write_usize(pointer_offset(buf.pointer, CONFIG_OFFSET_SCHEMA_JSON), 0)
      }
    }

    (buf, buffers)
  }
}

# Tantivy index manager
type pub TantivyIndexManager {
  let @config: TantivyConfig
  let mut @index: Option[Pointer[UInt8]]
}

impl TantivyIndexManager {
  fn pub static new(config: TantivyConfig) -> TantivyIndexManager {
    TantivyIndexManager(config: config, index: Option.None)
  }

  # Check if the FFI library is available
  # Uses tantivy_ping which is much more efficient than creating an index
  fn pub static ffi_available -> Int {
    tantivy_ping()
  }

  # Open or create the Tantivy index
  fn pub mut open -> Result[Bool, String] {
    let (c_config, _buffers) = @config.to_c_struct

    let (_error_out_storage, error_out_ptr) = allocate_error_output

    write_usize(error_out_ptr, 0)

    let index_ptr = tantivy_index_open(c_config.pointer, error_out_ptr)

    if is_null(index_ptr) {
      match check_ffi_error(error_out_ptr) {
        case Error(e) -> return Result.Error(e)
        case Ok(_) -> {
          return Result.Error(
            'Failed to open Tantivy index at path: ${@config.index_path}. '
              + 'Possible causes: 1) Path does not exist, 2) Insufficient permissions, '
              + '3) Path is not a valid directory, 4) Index is corrupted. '
              + 'Suggestions: Check path exists, verify read/write permissions, '
              + 'or recreate the index.',
          )
        }
      }
    } else {
      @index = Option.Some(index_ptr)
      Result.Ok(true)
    }
  }

  # Close the Tantivy index
  #
  # It is recommended to call close() explicitly before the manager
  # is dropped to ensure any errors are properly handled. If close()
  # is not called, Drop will attempt to close the index, but errors
  # will only be logged to stderr.
  fn pub mut close -> Result[Bool, String] {
    match @index {
      case Some(idx) -> {
        let result = tantivy_index_close(idx)

        @index = Option.None

        if (result as Int) == 0 {
          Result.Ok(true)
        } else {
          Result.Error(
            'Failed to close Tantivy index at path: ${@config.index_path}. '
              + 'This may indicate a resource leak or data corruption. '
              + 'The index may have been corrupted during the last operation. '
              + 'Action: Check for disk space issues or I/O errors.',
          )
        }
      }
      case None -> Result.Ok(true)
    }
  }

  # Check if index is open
  fn pub is_open -> Bool {
    match @index {
      case Some(_) -> true
      case None -> false
    }
  }

  # Add or update a document in the index
  fn pub mut add_doc(
    doc_id: String,
    fields: Array[(String, String)],
  ) -> Result[Bool, String] {
    match @index {
      case Some(idx) -> {
        # Validate field names (values are validated in FFI layer)
        for (field_name, _) in fields.iter {
          if field_name.size == 0 { return Result.Error('Field name cannot be empty') }
        }

        # Convert doc_id to C string
        let doc_id_buf = string_to_c_buffer(doc_id)

        # Create field array
        let field_count = fields.size
        let (fields_buf, _strings) = create_field_array(fields)
        let fields_ptr = fields_buf.pointer

        let (_error_out_storage, error_out_ptr) = allocate_error_output

        write_usize(error_out_ptr, 0)

        let result = tantivy_index_add_doc(
          idx,
          doc_id_buf.pointer,
          fields_ptr,
          field_count as Int64,
          error_out_ptr as Pointer[UInt8],
        )

        match check_ffi_error(error_out_ptr) {
          case Error(e) -> return Result.Error(e)
          case Ok(_) -> {}
        }

        if (result as Int) == 0 {
          Result.Ok(true)
        } else {
          Result.Error(
            'Failed to index document with ID: "${doc_id}". '
              + 'Possible causes: 1) Invalid field names, 2) Data exceeds buffer size, '
              + '3) Duplicate document ID, 4) Schema mismatch. '
              + 'Suggestions: Check field names match schema, reduce document size, '
              + 'or verify document ID is unique.',
          )
        }
      }
      case None -> Result.Error('Index is not open')
    }
  }

  # Add or update multiple documents in a batch (more efficient than individual add_doc calls)
  fn pub mut add_docs_batch(
    docs: Array[(String, Array[(String, String)])],
  ) -> Result[Int, String] {
    match @index {
      case Some(idx) -> {
        # Calculate total size needed
        let num_docs = docs.size
        let mut total_fields = 0

        for (_, fields) in docs.iter {
          total_fields = total_fields + fields.size
        }

        # Allocate batch documents array
        let docs_array_size = num_docs * 24
        let docs_buf = ByteArray.filled(with: 0, times: docs_array_size)
        let docs_ptr = docs_buf.pointer

        # Allocate fields array for all documents
        let fields_array_size = total_fields * FIELD_SIZE
        let fields_buf = ByteArray.filled(with: 0, times: fields_array_size)
        let fields_ptr = fields_buf.pointer

        # Fill in batch documents
        let mut doc_offset = 0
        let mut field_offset = 0
        let mut string_buffers = []

        for (doc_id, fields) in docs.iter {
          # Convert doc_id to C string and store pointer
          let doc_id_buf = string_to_c_buffer(doc_id)

          # Write doc_id pointer to batch documents array
          write_usize(
            ((docs_ptr as Int) + doc_offset) as Pointer[UInt8],
            pointer_to_int(doc_id_buf.pointer),
          )

          string_buffers.push(doc_id_buf)

          # Write fields pointer and count to batch documents array
          let num_fields = fields.size

          for (key, value) in fields.iter {
            let key_buf = string_to_c_buffer(key)
            let value_buf = string_to_c_buffer(value)

            # Write key pointer to fields array
            write_usize(
              ((fields_ptr as Int) + field_offset) as Pointer[UInt8],
              pointer_to_int(key_buf.pointer),
            )

            # Write value pointer to fields array
            write_usize(
              ((fields_ptr as Int) + field_offset + 8) as Pointer[UInt8],
              pointer_to_int(value_buf.pointer),
            )

            field_offset = field_offset + FIELD_SIZE

            string_buffers.push(key_buf)
            string_buffers.push(value_buf)
          }

          # Write fields pointer and count for this document
          write_usize(
            ((docs_ptr as Int) + doc_offset + 8) as Pointer[UInt8],
            fields_ptr as Int,
          )

          write_usize(
            ((docs_ptr as Int) + doc_offset + 16) as Pointer[UInt8],
            num_fields as Int,
          )

          doc_offset = doc_offset + 24
        }

        let (_error_out_storage, error_out_ptr) = allocate_error_output

        write_usize(error_out_ptr, 0)

        let result = tantivy_index_add_docs_batch(
          idx,
          docs_ptr,
          num_docs as Int64,
          error_out_ptr,
        )

        match check_ffi_error(error_out_ptr) {
          case Error(e) -> return Result.Error(e)
          case Ok(_) -> {}
        }

        if (result as Int) >= 0 {
          Result.Ok(result as Int)
        } else {
          Result.Error(
            'Failed to add documents batch. '
              + 'Possible causes: 1) Invalid field names in one or more documents, '
              + '2) Data exceeds buffer size, 3) Duplicate document IDs, 4) Schema mismatch. '
              + 'Suggestions: Check field names match schema, reduce document sizes, '
              + 'or verify document IDs are unique.',
          )
        }
      }
      case None -> Result.Error('Index is not open')
    }
  }

  # Delete a document from the index
  fn pub mut delete_doc(doc_id: String) -> Result[Bool, String] {
    match @index {
      case Some(idx) -> {
        # Convert doc_id to C string
        let doc_id_buf = string_to_c_buffer(doc_id)

        let (_error_out_storage, error_out_ptr) = allocate_error_output

        write_usize(error_out_ptr, 0)

        let result = tantivy_index_delete_doc(
          idx,
          doc_id_buf.pointer,
          error_out_ptr,
        )

        match check_ffi_error(error_out_ptr) {
          case Error(e) -> return Result.Error(e)
          case Ok(_) -> {}
        }

        if (result as Int) == 0 {
          Result.Ok(true)
        } else {
          Result.Error(
            'Failed to delete document with ID: "${doc_id}". '
              + 'Possible causes: 1) Document ID does not exist, 2) Index is locked, '
              + '3) Insufficient permissions. '
              + 'Suggestions: Verify document ID exists, check if index is being modified, '
              + 'or verify write permissions.',
          )
        }
      }
      case None -> Result.Error('Index is not open')
    }
  }

  # Delete multiple documents from the index
  #
  # Uses batch delete FFI function for improved efficiency. The FFI function
  # still calls delete_term for each document internally, but this reduces
  # FFI round-trips compared to calling delete_doc for each document.
  fn pub mut delete_documents(doc_ids: Array[String]) -> Result[Int, String] {
    match @index {
      case None -> Result.Error('Index is not open')
      case Some(idx) -> {
        # Get array size before moving
        let doc_ids_count = doc_ids.size

        # Convert array of strings to array of C string pointers
        let c_strings = string_array_to_c_pointers(doc_ids)

        let (_error_out_storage, error_out_ptr) = allocate_error_output

        write_usize(error_out_ptr, 0)

        # Call batch delete
        let result = tantivy_index_delete_docs(
          idx,
          c_strings.pointer,
          doc_ids_count as Int64,
          error_out_ptr,
        )

        # Check for errors
        if (result as Int) == -1 {
          # Error occurred - read error message
          match check_ffi_error(error_out_ptr) {
            case Error(e) -> Result.Error(e)
            case Ok(_) -> Result.Error('Batch delete failed with unknown error')
          }
        } else {
          Result.Ok(result as Int)
        }
      }
    }
  }

  # Delete documents by account and folder (for IMAP sync)
  fn pub mut delete_by_account_folder(
    account_id: String,
    folder_name: String,
    uids: Array[Int],
  ) -> Result[Int, String] {
    let mut doc_ids = []

    for uid in uids { doc_ids.push('${account_id}:${folder_name}:${uid}') }

    self.delete_documents(doc_ids)
  }

  # Search the index
  fn pub search(
    query: String,
    limit: Int,
    offset: Int,
  ) -> Result[Array[TantivyResult], String] {
    # Validate parameters
    match validate_query(query) {
      case Ok(_) -> {}
      case Error(e) -> return Result.Error('Invalid query: ${e}')
    }

    match validate_limit(limit, 'search') {
      case Ok(_) -> {}
      case Error(e) -> return Result.Error('Invalid limit: ${e}')
    }

    match validate_offset(offset) {
      case Ok(_) -> {}
      case Error(e) -> return Result.Error('Invalid offset: ${e}')
    }

    match @index {
      case Some(idx) -> {
        # Convert query to C string
        let query_buf = string_to_c_buffer(query)

        # Allocate output pointers
        let results_out_storage = ByteArray.filled(with: 0, times: 8)
        let num_results_out_storage = ByteArray.filled(with: 0, times: 8)
        let error_out_storage = ByteArray.filled(with: 0, times: 8)

        let results_out_ptr = results_out_storage.pointer
        let num_results_out_ptr = num_results_out_storage.pointer
        let error_out_ptr = error_out_storage.pointer

        write_usize(results_out_ptr, 0)
        write_usize(num_results_out_ptr, 0)
        write_usize(error_out_ptr, 0)

        let result = tantivy_index_search(
          idx,
          query_buf.pointer,
          limit as Int64,
          offset as Int64,
          results_out_ptr as Pointer[UInt8],
          num_results_out_ptr as Pointer[UInt64],
          error_out_ptr as Pointer[UInt8],
        )

        # Release query buffer back to pool
        release_string_buffer(query_buf)

        match check_ffi_error(error_out_ptr) {
          case Error(e) -> return Result.Error(e)
          case Ok(_) -> {}
        }

        if (result as Int) != 0 {
          return Result.Error(
            'Search failed for query: "${query}" (limit: ${limit}, offset: ${offset}). '
              + 'Possible causes: 1) Invalid query syntax, 2) Index not yet committed, '
              + '3) Invalid limit/offset values, 4) Field name not in schema. '
              + 'Suggestions: Check query syntax, verify index is committed, '
              + 'or reduce limit/offset values.',
          )
        }

        # Parse results from C array
        let results_ptr_addr = read_usize(results_out_ptr)
        let num_results = read_usize(num_results_out_ptr)

        let mut results = []

        if results_ptr_addr != 0 and num_results > 0 {
          let results_ptr = results_ptr_addr as Pointer[UInt8]

          let mut i = 0

          while i < num_results {
            let base_ptr = c_array_element_ptr(results_ptr, i, RESULT_SIZE)

            let doc_id = read_string_field(
              base_ptr,
              RESULT_OFFSET_DOC_ID,
              @config.string_buffer_size,
            )
            let score_ptr = pointer_offset(base_ptr, RESULT_OFFSET_SCORE)
              as Pointer[Float32]
            let score = score_ptr.0 as Float
            let highlight = read_optional_string_field(
              base_ptr,
              RESULT_OFFSET_HIGHLIGHT,
              @config.string_buffer_size,
            )

            results.push(
              TantivyResult(doc_id: doc_id, score: score, highlight: highlight),
            )

            i = i + 1
          }
        }

        # Free results array
        if results_ptr_addr != 0 and num_results > 0 {
          let results_ptr = results_ptr_addr as Pointer[UInt8]

          tantivy_result_free(results_ptr, num_results as Int64)
        }

        Result.Ok(results)
      }
      case None -> Result.Error('Index is not open')
    }
  }

  # Commit pending changes
  fn pub mut commit -> Result[Bool, String] {
    match @index {
      case Some(idx) -> {
        let (_error_out_storage, error_out_ptr) = allocate_error_output

        write_usize(error_out_ptr, 0)

        let result = tantivy_index_commit(idx, error_out_ptr)

        match check_ffi_error(error_out_ptr) {
          case Error(e) -> return Result.Error(e)
          case Ok(_) -> {}
        }

        if (result as Int) == 0 {
          Result.Ok(true)
        } else {
          Result.Error(
            'Failed to commit changes to Tantivy index. '
              + 'Possible causes: 1) Disk is full, 2) I/O error, 3) Index corruption, '
              + '4) Insufficient memory. '
              + 'Suggestions: Check disk space, verify I/O permissions, '
              + 'or consider rolling back the last operation.',
          )
        }
      }
      case None -> Result.Error('Index is not open')
    }
  }

  # Rollback pending changes
  fn pub mut rollback -> Result[Bool, String] {
    match @index {
      case Some(idx) -> {
        # Allocate error output pointer
        let (_error_out_storage, error_out_ptr) = allocate_error_output

        write_usize(error_out_ptr, 0)

        let result = tantivy_index_rollback(idx, error_out_ptr)

        match check_ffi_error(error_out_ptr) {
          case Error(e) -> return Result.Error(e)
          case Ok(_) -> {}
        }

        if (result as Int) == 0 {
          Result.Ok(true)
        } else {
          Result.Error(
            'Failed to rollback changes in Tantivy index. '
              + 'Possible causes: 1) Index is in inconsistent state, 2) I/O error, '
              + '3) No pending changes to rollback. '
              + 'Suggestions: Verify index state, check I/O permissions, '
              + 'or reopen the index if needed.',
          )
        }
      }
      case None -> Result.Error('Index is not open')
    }
  }

  # Get a document by its ID
  # Returns a JSON string with all document fields, or error if not found
  fn pub get_doc(doc_id: String) -> Result[String, String] {
    match @index {
      case Some(idx) -> {
        # Convert doc_id to C string
        let doc_id_buf = string_to_c_buffer(doc_id)

        # Allocate error output pointer
        let (_error_out_storage, error_out_ptr) = allocate_error_output

        write_usize(error_out_ptr, 0)

        # Call the FFI function
        let result_ptr = tantivy_index_get_doc(
          idx,
          doc_id_buf.pointer,
          error_out_ptr,
        )

        match check_ffi_error(error_out_ptr) {
          case Error(e) -> Result.Error(e)
          case Ok(_) -> {
            if (result_ptr as Int) == 0 {
              # Document not found
              Result.Error('Document not found with ID: "${doc_id}"')
            } else {
              # Parse the JSON result with truncation checking
              let (json_str, truncated) = c_pointer_to_string_checked(
                result_ptr,
                @config.json_buffer_size,
              )

              # Free the string allocated by Rust
              tantivy_string_free(result_ptr)

              if truncated {
                Result.Error(
                  'Document exceeds maximum size (${@config.json_buffer_size} bytes)',
                )
              } else {
                Result.Ok(json_str)
              }
            }
          }
        }
      }
      case None -> Result.Error('Index is not open')
    }
  }

  # Get multiple documents by their IDs
  # Returns an array of JSON strings with all document fields
  # Missing documents are represented as empty strings in the array
  fn pub get_docs(doc_ids: Array[String]) -> Result[Array[String], String] {
    match @index {
      case Some(idx) -> {
        if doc_ids.size == 0 { return Result.Ok([]) }

        # Create array of C string pointers
        let num_ids = doc_ids.size
        let ids_array_size = num_ids * PTR_SIZE
        let ids_array_buf = ByteArray.filled(with: 0, times: ids_array_size)

        # Keep track of all string buffers so they stay alive during FFI call
        let mut string_buffers = []

        let mut i = 0

        for doc_id in doc_ids {
          let doc_id_buf = string_to_c_buffer(doc_id)

          # Write pointer to the array
          write_usize(
            pointer_offset(ids_array_buf.pointer, i * PTR_SIZE),
            pointer_to_int(doc_id_buf.pointer),
          )

          string_buffers.push(doc_id_buf)
          i = i + 1
        }

        let num_results_out_storage = ByteArray.filled(with: 0, times: 8)
        let (_error_out_storage, error_out_ptr) = allocate_error_output

        let num_results_out_ptr = num_results_out_storage.pointer

        write_usize(num_results_out_ptr, 0)
        write_usize(error_out_ptr, 0)

        # Call the FFI function
        let results_ptr = tantivy_index_get_docs(
          idx,
          ids_array_buf.pointer,
          num_ids as Int64,
          num_results_out_ptr as Pointer[UInt64],
          error_out_ptr,
        )

        match check_ffi_error(error_out_ptr) {
          case Error(e) -> {
            # Free results array before returning error
            if (results_ptr as Int) != 0 {
              let num_results = read_usize(num_results_out_ptr)

              tantivy_docs_array_free(results_ptr, num_results as Int64)
            }

            Result.Error(e)
          }
          case Ok(_) -> {
            if (results_ptr as Int) == 0 {
              # No documents found
              Result.Ok([])
            } else {
              # Parse results from C array
              let num_results = read_usize(num_results_out_ptr)
              let mut documents = []

              if num_results > 0 {
                let mut j = 0

                while j < num_results {
                  let doc_ptr_addr = (results_ptr as Int) + (j * PTR_SIZE)
                  let doc_ptr = doc_ptr_addr as Pointer[UInt8]

                  let doc_json = if (doc_ptr as Int) != 0 {
                    let (json_str, truncated) = c_pointer_to_string_checked(
                      doc_ptr,
                      @config.json_buffer_size,
                    )

                    tantivy_string_free(doc_ptr)

                    if truncated {
                      # Return error indicator for truncated document
                      '{"error":"document_too_large"}'
                    } else {
                      json_str
                    }
                  } else {
                    ''
                  }

                  documents.push(doc_json)
                  j = j + 1
                }
              }

              # Free the results array
              tantivy_docs_array_free(results_ptr, num_results as Int64)

              Result.Ok(documents)
            }
          }
        }
      }
      case None -> Result.Error('Index is not open')
    }
  }

  # Perform a terms aggregation (count documents by field values)
  # Returns results sorted by count (descending)
  fn pub aggregate_terms(
    field_name: String,
    query: String,
    limit: Int,
  ) -> Result[Array[TantivyAggregationResult], String] {
    match @index {
      case Some(idx) -> {
        let field_buf = string_to_c_buffer(field_name)
        let query_buf = string_to_c_buffer(query)

        let results_out_storage = ByteArray.filled(with: 0, times: 8)
        let num_results_out_storage = ByteArray.filled(with: 0, times: 8)
        let (_error_out_storage, error_out_ptr) = allocate_error_output

        let results_out_ptr = results_out_storage.pointer
        let num_results_out_ptr = num_results_out_storage.pointer

        write_usize(results_out_ptr, 0)
        write_usize(num_results_out_ptr, 0)
        write_usize(error_out_ptr, 0)

        let result = tantivy_aggregate_terms(
          idx,
          field_buf.pointer,
          query_buf.pointer,
          limit as Int64,
          results_out_ptr as Pointer[UInt8],
          num_results_out_ptr as Pointer[UInt64],
          error_out_ptr as Pointer[UInt8],
        )

        match check_ffi_error(error_out_ptr) {
          case Error(e) -> return Result.Error(e)
          case Ok(_) -> {}
        }

        if (result as Int) != 0 {
          return Result.Error(
            'Term aggregation failed for field: "${field_name}" with query: "${query}"',
          )
        }

        let results_ptr_addr = read_usize(results_out_ptr)
        let num_results = read_usize(num_results_out_ptr)

        let mut results = []

        if results_ptr_addr != 0 and num_results > 0 {
          let results_ptr = results_ptr_addr as Pointer[UInt8]

          let mut j = 0

          while j < num_results {
            let base_ptr = c_array_element_ptr(results_ptr, j, AGGREGATION_SIZE)

            let key = read_string_field(
              base_ptr,
              AGGREGATION_OFFSET_KEY,
              @config.string_buffer_size,
            )
            let count_ptr = pointer_offset(base_ptr, AGGREGATION_OFFSET_COUNT)
              as Pointer[UInt64]
            let count = count_ptr.0 as Int

            results.push(TantivyAggregationResult(key: key, count: count))

            j = j + 1
          }

          tantivy_aggregation_results_free(results_ptr, num_results as Int64)
        }

        Result.Ok(results)
      }
      case None -> Result.Error('Index is not open')
    }
  }

  # Get facet counts for a field (uses default limit of 1000)
  # For custom limits, use aggregate_terms() directly
  fn pub get_facet_counts(
    field_name: String,
    query: String,
  ) -> Result[Array[TantivyAggregationResult], String] {
    self.aggregate_terms(field_name, query, 1000)
  }

  # Autocomplete: Get suggestions for a prefix query
  fn pub autocomplete(
    field: String,
    prefix: String,
    limit: Int,
  ) -> Result[Array[TantivySuggestion], String] {
    # Validate parameters
    match validate_field_name(field) {
      case Ok(_) -> {}
      case Error(e) -> return Result.Error('Invalid field name: ${e}')
    }

    match validate_query(prefix) {
      case Ok(_) -> {}
      case Error(e) -> return Result.Error('Invalid prefix: ${e}')
    }

    match validate_limit(limit, 'autocomplete') {
      case Ok(_) -> {}
      case Error(e) -> return Result.Error('Invalid limit: ${e}')
    }

    match @index {
      case Some(idx) -> {
        let field_buf = string_to_c_buffer(field)
        let prefix_buf = string_to_c_buffer(prefix)

        let results_out_storage = ByteArray.filled(with: 0, times: 8)
        let num_results_out_storage = ByteArray.filled(with: 0, times: 8)
        let (_error_out_storage, error_out_ptr) = allocate_error_output

        let results_out_ptr = results_out_storage.pointer
        let num_results_out_ptr = num_results_out_storage.pointer

        write_usize(results_out_ptr, 0)
        write_usize(num_results_out_ptr, 0)
        write_usize(error_out_ptr, 0)

        let result = tantivy_autocomplete(
          idx,
          field_buf.pointer,
          prefix_buf.pointer,
          limit as Int64,
          results_out_ptr as Pointer[UInt8],
          num_results_out_ptr as Pointer[UInt64],
          error_out_ptr as Pointer[UInt8],
        )

        match check_ffi_error(error_out_ptr) {
          case Error(e) -> return Result.Error(e)
          case Ok(_) -> {}
        }

        if (result as Int) != 0 {
          return Result.Error(
            'Autocomplete failed for field: "${field}", prefix: "${prefix}" (no error details available)',
          )
        }

        let results_ptr_addr = read_usize(results_out_ptr)
        let num_results = read_usize(num_results_out_ptr)

        let mut results = []

        if results_ptr_addr != 0 and num_results > 0 {
          let results_ptr = results_ptr_addr as Pointer[UInt8]

          let mut j = 0

          while j < num_results {
            let base_ptr = c_array_element_ptr(results_ptr, j, SUGGESTION_SIZE)

            let text = read_string_field(
              base_ptr,
              SUGGESTION_OFFSET_TEXT,
              @config.string_buffer_size,
            )
            let score_ptr = pointer_offset(base_ptr, SUGGESTION_OFFSET_SCORE)
              as Pointer[Float32]
            let score = score_ptr.0 as Float

            results.push(TantivySuggestion(text: text, score: score))

            j = j + 1
          }

          tantivy_suggestions_free(results_ptr, num_results as Int64)
        }

        Result.Ok(results)
      }
      case None -> Result.Error('Index is not open')
    }
  }

  # Did-you-mean: Get similar terms using fuzzy query
  # distance: edit distance (0-2 typical)
  fn pub did_you_mean(
    field: String,
    term: String,
    distance: Int,
    limit: Int,
  ) -> Result[Array[TantivySuggestion], String] {
    # Validate parameters
    match validate_field_name(field) {
      case Ok(_) -> {}
      case Error(e) -> return Result.Error('Invalid field name: ${e}')
    }

    match validate_query(term) {
      case Ok(_) -> {}
      case Error(e) -> return Result.Error('Invalid term: ${e}')
    }

    match validate_distance(distance) {
      case Ok(_) -> {}
      case Error(e) -> return Result.Error('Invalid distance: ${e}')
    }

    match validate_limit(limit, 'did_you_mean') {
      case Ok(_) -> {}
      case Error(e) -> return Result.Error('Invalid limit: ${e}')
    }

    match @index {
      case Some(idx) -> {
        let field_buf = string_to_c_buffer(field)
        let term_buf = string_to_c_buffer(term)

        let results_out_storage = ByteArray.filled(with: 0, times: 8)
        let num_results_out_storage = ByteArray.filled(with: 0, times: 8)
        let (_error_out_storage, error_out_ptr) = allocate_error_output

        let results_out_ptr = results_out_storage.pointer
        let num_results_out_ptr = num_results_out_storage.pointer

        write_usize(results_out_ptr, 0)
        write_usize(num_results_out_ptr, 0)
        write_usize(error_out_ptr, 0)

        let result = tantivy_did_you_mean(
          idx,
          field_buf.pointer,
          term_buf.pointer,
          distance as Int32,
          limit as Int64,
          results_out_ptr as Pointer[UInt8],
          num_results_out_ptr as Pointer[UInt64],
          error_out_ptr as Pointer[UInt8],
        )

        match check_ffi_error(error_out_ptr) {
          case Error(e) -> return Result.Error(e)
          case Ok(_) -> {}
        }

        if (result as Int) != 0 {
          return Result.Error(
            'Did-you-mean failed for field: "${field}", term: "${term}" (no error details available)',
          )
        }

        let results_ptr_addr = read_usize(results_out_ptr)
        let num_results = read_usize(num_results_out_ptr)

        let mut results = []

        if results_ptr_addr != 0 and num_results > 0 {
          let results_ptr = results_ptr_addr as Pointer[UInt8]

          let mut j = 0

          while j < num_results {
            let base_ptr = c_array_element_ptr(results_ptr, j, SUGGESTION_SIZE)

            let text = read_string_field(
              base_ptr,
              SUGGESTION_OFFSET_TEXT,
              @config.string_buffer_size,
            )
            let score_ptr = pointer_offset(base_ptr, SUGGESTION_OFFSET_SCORE)
              as Pointer[Float32]
            let score = score_ptr.0 as Float

            results.push(TantivySuggestion(text: text, score: score))

            j = j + 1
          }

          tantivy_suggestions_free(results_ptr, num_results as Int64)
        }

        Result.Ok(results)
      }
      case None -> Result.Error('Index is not open')
    }
  }
}

impl Drop for TantivyIndexManager {
  fn mut drop {
    match @index {
      case Some(idx) -> {
        let result = tantivy_index_close(idx)

        @index = Option.None

        if (result as Int) != 0 {
          Stderr.new.print(
            '[TANTIVY_DROP] Warning: Failed to close index during '
              + 'automatic cleanup. Consider calling close() explicitly. '
              + 'Error code: ${result as Int}',
          )
        }
      }
      case None -> {}
    }
  }
}
