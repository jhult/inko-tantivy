# Tantivy index manager (facade)
#
# This module provides the main public API for managing Tantivy search indexes.
# It is a thin facade that owns a TantivyIndexLifecycle and delegates operations
# to the index_writer and index_searcher modules.

import std.drop (Drop)
import std.stdio (Stderr)
import tantivy.ffi (tantivy_ping)
import tantivy.index_lifecycle (TantivyIndexLifecycle)
import tantivy.index_searcher
import tantivy.index_writer
import tantivy.types (
  TantivyAggregationResult, TantivyConfig, TantivyResult, TantivySuggestion,
)

# Tantivy index manager
type pub TantivyIndexManager {
  let mut @lifecycle: TantivyIndexLifecycle
}

impl TantivyIndexManager {
  fn pub static new(config: TantivyConfig) -> TantivyIndexManager {
    TantivyIndexManager(lifecycle: TantivyIndexLifecycle.new(config))
  }

  # Check if the FFI library is available
  # Uses tantivy_ping which is much more efficient than creating an index
  fn pub static ffi_available -> Int {
    tantivy_ping()
  }

  # Open or create the Tantivy index
  fn pub mut open -> Result[Bool, String] {
    @lifecycle.open
  }

  # Close the Tantivy index
  fn pub mut close -> Result[Bool, String] {
    @lifecycle.close
  }

  # Check if index is open
  fn pub is_open -> Bool {
    @lifecycle.is_open
  }

  # Commit pending changes
  fn pub mut commit -> Result[Bool, String] {
    @lifecycle.commit
  }

  # Rollback pending changes
  fn pub mut rollback -> Result[Bool, String] {
    @lifecycle.rollback
  }

  # Add or update a document in the index
  fn pub mut add_doc(
    doc_id: String,
    fields: Array[(String, String)],
  ) -> Result[Bool, String] {
    match @lifecycle.index_ptr {
      case Some(idx) -> index_writer.add_doc(idx, doc_id, fields)
      case None -> Result.Error('Index is not open')
    }
  }

  # Add or update multiple documents in a batch
  fn pub mut add_docs_batch(
    docs: Array[(String, Array[(String, String)])],
  ) -> Result[Int, String] {
    match @lifecycle.index_ptr {
      case Some(idx) -> index_writer.add_docs_batch(idx, docs)
      case None -> Result.Error('Index is not open')
    }
  }

  # Delete a document from the index
  fn pub mut delete_doc(doc_id: String) -> Result[Bool, String] {
    match @lifecycle.index_ptr {
      case Some(idx) -> index_writer.delete_doc(idx, doc_id)
      case None -> Result.Error('Index is not open')
    }
  }

  # Delete multiple documents from the index
  fn pub mut delete_documents(doc_ids: Array[String]) -> Result[Int, String] {
    match @lifecycle.index_ptr {
      case Some(idx) -> index_writer.delete_documents(idx, doc_ids)
      case None -> Result.Error('Index is not open')
    }
  }

  # Delete documents by account and folder (for IMAP sync)
  fn pub mut delete_by_account_folder(
    account_id: String,
    folder_name: String,
    uids: Array[Int],
  ) -> Result[Int, String] {
    match @lifecycle.index_ptr {
      case Some(idx) -> {
        index_writer.delete_by_account_folder(
          idx,
          account_id,
          folder_name,
          uids,
        )
      }
      case None -> Result.Error('Index is not open')
    }
  }

  # Search the index
  fn pub mut search(
    query: String,
    limit: Int,
    offset: Int,
  ) -> Result[Array[TantivyResult], String] {
    match @lifecycle.index_ptr {
      case Some(idx) -> {
        let sbs = @lifecycle.config.string_buffer_size

        index_searcher.search(idx, sbs, query, limit, offset)
      }
      case None -> Result.Error('Index is not open')
    }
  }

  # Get a document by its ID
  fn pub mut get_doc(doc_id: String) -> Result[String, String] {
    match @lifecycle.index_ptr {
      case Some(idx) -> {
        let jbs = @lifecycle.config.json_buffer_size

        index_searcher.get_doc(idx, jbs, doc_id)
      }
      case None -> Result.Error('Index is not open')
    }
  }

  # Get multiple documents by their IDs
  fn pub mut get_docs(doc_ids: Array[String]) -> Result[Array[String], String] {
    match @lifecycle.index_ptr {
      case Some(idx) -> {
        let jbs = @lifecycle.config.json_buffer_size

        index_searcher.get_docs(idx, jbs, doc_ids)
      }
      case None -> Result.Error('Index is not open')
    }
  }

  # Perform a terms aggregation
  fn pub mut aggregate_terms(
    field_name: String,
    query: String,
    limit: Int,
  ) -> Result[Array[TantivyAggregationResult], String] {
    match @lifecycle.index_ptr {
      case Some(idx) -> {
        let sbs = @lifecycle.config.string_buffer_size

        index_searcher.aggregate_terms(idx, sbs, field_name, query, limit)
      }
      case None -> Result.Error('Index is not open')
    }
  }

  # Get facet counts for a field
  fn pub mut get_facet_counts(
    field_name: String,
    query: String,
  ) -> Result[Array[TantivyAggregationResult], String] {
    match @lifecycle.index_ptr {
      case Some(idx) -> {
        let sbs = @lifecycle.config.string_buffer_size

        index_searcher.get_facet_counts(idx, sbs, field_name, query)
      }
      case None -> Result.Error('Index is not open')
    }
  }

  # Autocomplete: Get suggestions for a prefix query
  fn pub mut autocomplete(
    field: String,
    prefix: String,
    limit: Int,
  ) -> Result[Array[TantivySuggestion], String] {
    match @lifecycle.index_ptr {
      case Some(idx) -> {
        let sbs = @lifecycle.config.string_buffer_size

        index_searcher.autocomplete(idx, sbs, field, prefix, limit)
      }
      case None -> Result.Error('Index is not open')
    }
  }

  # Did-you-mean: Get similar terms using fuzzy query
  fn pub mut did_you_mean(
    field: String,
    term: String,
    distance: Int,
    limit: Int,
  ) -> Result[Array[TantivySuggestion], String] {
    match @lifecycle.index_ptr {
      case Some(idx) -> {
        let sbs = @lifecycle.config.string_buffer_size

        index_searcher.did_you_mean(idx, sbs, field, term, distance, limit)
      }
      case None -> Result.Error('Index is not open')
    }
  }
}

impl Drop for TantivyIndexManager {
  fn mut drop {
    match @lifecycle.index_ptr {
      case Some(_) -> {
        match @lifecycle.close {
          case Ok(_) -> {}
          case Error(e) -> {
            Stderr.new.print(
              '[TANTIVY_DROP] Warning: Failed to close index during '
                + 'automatic cleanup. Consider calling close() explicitly. '
                + 'Error: ${e}',
            )
          }
        }
      }
      case None -> {}
    }
  }
}
