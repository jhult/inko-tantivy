# Memory marshaling utilities for Tantivy FFI
#
# This module provides helper functions for converting between Inko and C types,
# handling string marshaling, and managing memory buffers for FFI operations.

import pointer_helpers (pointer_offset, pointer_to_int, read_usize, write_usize)
import std.bytes (ByteArray)
import std.string (StringBuffer)
import tantivy.ffi (
  FIELD_OFFSET_VALUE, FIELD_SIZE, TANTIVY_ERROR_BUFFER_SIZE, tantivy_error_free,
)

# FFI Context manages lifetime of strings for FFI operations
type pub FFIContext {
  let mut @strings: Array[String]
}

impl FFIContext {
  fn pub static new -> Self {
    FFIContext(strings: [])
  }

  fn pub mut retain_string(s: String) {
    @strings.push(s)
  }

  fn pub mut clear {
    @strings = []
  }
}

# Helper: Join array of strings with separator
fn pub join_strings(strings: ref Array[String], sep: String) -> String {
  let mut buffer = StringBuffer.new
  let mut first = true

  for s in strings.iter {
    if !first { buffer.push(sep) }

    buffer.push(s)
    first = false
  }

  buffer.into_string
}

# Helper: Get pointer to C array element at given index
# Reduces repetitive pointer arithmetic in parsing loops
fn pub c_array_element_ptr(
  base_ptr: Pointer[UInt8],
  index: Int,
  struct_size: Int,
) -> Pointer[UInt8] {
  ((base_ptr as Int) + (index * struct_size)) as Pointer[UInt8]
}

# Get pointer to Inko string for passing to C
# Inko strings are immutable and already NULL-terminated, so we can pass
# the internal pointer directly without copying
fn pub string_to_c_buffer(s: String) -> String {
  s
}

# No-op for string_to_c_buffer - strings are passed by reference
fn pub release_string_buffer(buffer: String) {}

# Helper: Read a string field from a C struct at given offset
# Handles null pointer check and conversion
# Takes buffer_size as parameter to allow configurable buffer sizes
fn pub read_string_field(
  base_ptr: Pointer[UInt8],
  offset: Int,
  buffer_size: Int,
) -> String {
  let ptr_addr = read_usize(pointer_offset(base_ptr, offset))

  if ptr_addr != 0 {
    let ptr = ptr_addr as Pointer[UInt8]

    c_pointer_to_string(ptr, buffer_size)
  } else {
    ''
  }
}

# Helper: Read an optional string field from a C struct at given offset
#
# Returns:
# - Option.Some(value) if field exists and has non-empty content
# - Option.None if field pointer is null (field not present) OR string is empty (field present but empty)
#
# Why empty strings return None:
# - This design treats "field not set" and "field set to empty" equivalently
# - Matches typical database behavior where NULL and empty string often treated the same
# - Simplifies API by requiring only one check (if field exists) instead of two
# - For email schema specifically, empty optional fields are semantically equivalent to absent
#
# If you need to distinguish "not set" from "empty", use read_string_field instead
# and check for null/empty explicitly in your code.
#
# Takes buffer_size as parameter to allow configurable buffer sizes
fn pub read_optional_string_field(
  base_ptr: Pointer[UInt8],
  offset: Int,
  buffer_size: Int,
) -> Option[String] {
  let ptr_addr = read_usize(pointer_offset(base_ptr, offset))

  if ptr_addr != 0 {
    let ptr = ptr_addr as Pointer[UInt8]
    let str = c_pointer_to_string(ptr, buffer_size)

    if str.size > 0 { Option.Some(str) } else { Option.None }
  } else {
    Option.None
  }
}

# Helper: Create field array for document indexing
# Returns (ByteArray, Array[String]) where the array keeps strings alive during FFI call
fn pub create_field_array(
  fields: Array[(String, String)],
) -> (ByteArray, Array[String]) {
  let array_size = fields.size * FIELD_SIZE
  let buf = ByteArray.filled(with: 0, times: array_size)
  let mut strings = []
  let mut i = 0

  for (key, value) in fields {
    let base_offset = i * FIELD_SIZE

    write_usize(
      pointer_offset(buf.pointer, base_offset),
      pointer_to_int(key.pointer),
    )

    write_usize(
      pointer_offset(buf.pointer, base_offset + FIELD_OFFSET_VALUE),
      pointer_to_int(value.pointer),
    )

    strings.push(key)
    strings.push(value)
    i = i + 1
  }

  (buf, strings)
}

# Helper: Convert C pointer to String (reads until null terminator)
# Optimized to avoid allocating full max_len buffer for small strings
fn pub c_pointer_to_string(ptr: Pointer[UInt8], max_len: Int) -> String {
  if (ptr as Int) == 0 { return '' }

  # First pass: count bytes until null terminator
  let mut length = 0
  let mut counting = true

  while counting and (length < max_len) {
    let byte_ptr = (ptr as Int + length) as Pointer[UInt8]
    let byte = byte_ptr.0

    if (byte as Int) == 0 { counting = false } else { length = length + 1 }
  }

  # Second pass: allocate only the exact size needed
  let bytes = ByteArray.filled(with: 0, times: length)
  let mut i = 0

  while i < length {
    let byte_ptr = (ptr as Int + i) as Pointer[UInt8]
    let byte = byte_ptr.0
    let _ = bytes.set(i, byte as Int)

    i = i + 1
  }

  # Convert bytes to string (only actual bytes, not full buffer)
  bytes.to_string
}

# Helper: Convert C pointer to String with truncation detection
# Returns (string, was_truncated) tuple for detecting buffer overflow
# Optimized to avoid allocating full max_len buffer for small strings
fn pub c_pointer_to_string_checked(
  ptr: Pointer[UInt8],
  max_len: Int,
) -> (String, Bool) {
  if (ptr as Int) == 0 { return ('', false) }

  # First pass: count bytes until null terminator
  let mut length = 0
  let mut counting = true

  while counting and (length < max_len) {
    let byte_ptr = (ptr as Int + length) as Pointer[UInt8]
    let byte = byte_ptr.0

    if (byte as Int) == 0 { counting = false } else { length = length + 1 }
  }

  # Check if we hit the limit without finding null terminator
  let truncated = counting and (length >= max_len)

  # Second pass: allocate only the exact size needed
  let bytes = ByteArray.filled(with: 0, times: length)
  let mut i = 0

  while i < length {
    let byte_ptr = (ptr as Int + i) as Pointer[UInt8]
    let byte = byte_ptr.0
    let _ = bytes.set(i, byte as Int)

    i = i + 1
  }

  # Convert bytes to string (only actual bytes, not full buffer)
  (bytes.to_string, truncated)
}

# Helper: Allocate error output storage and return storage and pointer
fn pub allocate_error_output -> (ByteArray, Pointer[UInt8]) {
  let error_out_storage = ByteArray.filled(with: 0, times: 8)
  let error_out_ptr = error_out_storage.pointer

  (error_out_storage, error_out_ptr)
}

# Helper: Allocate and initialize error output storage
# Returns storage (for lifetime) and pointer (for FFI)
fn pub allocate_and_init_error -> (ByteArray, Pointer[UInt8]) {
  let (storage, ptr) = allocate_error_output

  write_usize(ptr, 0)
  (storage, ptr)
}

# Helper: Check FFI error pointer and return error message if present
# Returns Result.Ok(nil) if no error, Result.Error(message) if error occurred
fn pub check_ffi_error(error_out_ptr: Pointer[UInt8]) -> Result[Nil, String] {
  let error_ptr_addr = read_usize(error_out_ptr)

  if error_ptr_addr != 0 {
    let error_ptr = error_ptr_addr as Pointer[UInt8]
    let error_msg = c_pointer_to_string(error_ptr, TANTIVY_ERROR_BUFFER_SIZE)

    tantivy_error_free(error_ptr)
    Result.Error(error_msg)
  } else {
    Result.Ok(nil)
  }
}

# Convert array of Inko strings to array of C string pointers
#
# The returned FFIContext owns all string objects, ensuring they stay alive
# until the context is dropped. This prevents use-after-free bugs.
#
# Parameters:
#   strings: Array of Inko strings to convert
#
# Returns:
#   (pointers: ByteArray, ctx: FFIContext) where pointers contains C string
#   pointers (8 bytes per pointer) and ctx owns the string objects
#
# Usage:
#   let (c_strings, ctx) = string_array_to_c_pointers(strings)
#   let result = tantivy_ffi_call(c_strings.pointer)
#   # ctx keeps strings alive until scope ends
fn pub string_array_to_c_pointers(
  strings: Array[String],
) -> (ByteArray, FFIContext) {
  let pointers = ByteArray.filled(with: 0, times: strings.size * 8)
  let mut ctx = FFIContext.new
  let mut i = 0

  for s in strings {
    ctx.retain_string(s)

    let ptr = s.pointer
    let ptr_int = pointer_to_int(ptr)
    let _ = write_usize(pointer_offset(pointers.pointer, i), ptr_int)

    i = i + 8
  }

  (pointers, ctx)
}
