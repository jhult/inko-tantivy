# Custom schema integration tests

import helpers (cleanup_test_index, ffi_available, temp_index_path)
import std.test (Tests)
import tantivy.index_manager (TantivyIndexManager)
import tantivy.types (TantivyConfig)

fn pub tests(t: mut Tests) {
  if !ffi_available { return }

  t.test('Create index with custom text schema', fn (t) {
    let path = temp_index_path('custom-schema-001')
    let schema_json = '{
      "fields": [
        {"name": "id", "type": "string", "indexed": true, "stored": true},
        {"name": "title", "type": "text", "indexed": true, "stored": true},
        {"name": "content", "type": "text", "indexed": true, "stored": true}
      ],
      "default_search_fields": ["title", "content"]
    }'

    let config = match TantivyConfig.new(path) {
      case Ok(c) -> c
      case Error(_) -> {
        cleanup_test_index(path)
        t.true(false)
        return
      }
    }

    let config_with_schema = match config.with_schema_json(schema_json) {
      case Ok(c) -> c
      case Error(_) -> {
        cleanup_test_index(path)
        t.true(false)
        return
      }
    }

    let mut manager = TantivyIndexManager.new(config_with_schema)

    match manager.open {
      case Ok(_) -> {
        let fields = [('title', 'Test Title'), ('content', 'Test Content')]

        match manager.add_doc('doc-1', fields) {
          case Ok(_) -> t.true(true)
          case Error(_) -> t.true(false)
        }
      }
      case Error(_) -> t.true(false)
    }

    let _ = manager.close

    cleanup_test_index(path)
  })

  t.test('Search with custom text schema', fn (t) {
    let path = temp_index_path('custom-schema-002')
    let schema_json = '{
      "fields": [
        {"name": "id", "type": "string", "indexed": true, "stored": true},
        {"name": "title", "type": "text", "indexed": true, "stored": true},
        {"name": "content", "type": "text", "indexed": true, "stored": true}
      ],
      "default_search_fields": ["title", "content"]
    }'

    let config = match TantivyConfig.new(path) {
      case Ok(c) -> c
      case Error(_) -> {
        cleanup_test_index(path)
        t.true(false)
        return
      }
    }

    let config_with_schema = match config.with_schema_json(schema_json) {
      case Ok(c) -> c
      case Error(_) -> {
        cleanup_test_index(path)
        t.true(false)
        return
      }
    }

    let mut manager = TantivyIndexManager.new(config_with_schema)

    match manager.open {
      case Ok(_) -> {
        let fields = [
          ('title', 'Introduction to Search'),
          ('content', 'Full-text search is powerful'),
        ]

        let _ = manager.add_doc('doc-1', fields)
        let _ = manager.commit

        match manager.search('search', 10, 0) {
          case Ok(results) -> {
            if results.size > 0 { t.true(true) } else { t.true(false) }
          }
          case Error(_) -> t.true(false)
        }
      }
      case Error(_) -> t.true(false)
    }

    let _ = manager.close

    cleanup_test_index(path)
  })

  t.test('E-commerce schema with multiple field types', fn (t) {
    let path = temp_index_path('custom-schema-003')
    let schema_json = '{
      "fields": [
        {"name": "id", "type": "string", "indexed": true, "stored": true},
        {"name": "name", "type": "text", "indexed": true, "stored": true},
        {"name": "description", "type": "text", "indexed": true, "stored": true},
        {"name": "price", "type": "f64", "indexed": true, "stored": true},
        {"name": "category", "type": "string", "indexed": true, "stored": true},
        {"name": "in_stock", "type": "bool", "indexed": true, "stored": true},
        {"name": "sku", "type": "string", "indexed": true, "stored": true}
      ],
      "default_search_fields": ["name", "description"]
    }'

    let config = match TantivyConfig.new(path) {
      case Ok(c) -> c
      case Error(_) -> {
        cleanup_test_index(path)
        t.true(false)
        return
      }
    }

    let config_with_schema = match config.with_schema_json(schema_json) {
      case Ok(c) -> c
      case Error(_) -> {
        cleanup_test_index(path)
        t.true(false)
        return
      }
    }

    let mut manager = TantivyIndexManager.new(config_with_schema)

    match manager.open {
      case Ok(_) -> {
        let fields = [
          ('name', 'Laptop'),
          ('description', 'High-performance laptop for developers'),
          ('price', '1299.99'),
          ('category', 'Electronics'),
          ('in_stock', 'true'),
          ('sku', 'LAP-001'),
        ]

        match manager.add_doc('product-1', fields) {
          case Ok(_) -> {
            match manager.commit {
              case Ok(_) -> t.true(true)
              case Error(_) -> t.true(false)
            }
          }
          case Error(_) -> t.true(false)
        }
      }
      case Error(_) -> t.true(false)
    }

    let _ = manager.close

    cleanup_test_index(path)
  })

  t.test('Log search schema with u64 fields', fn (t) {
    let path = temp_index_path('custom-schema-004')
    let schema_json = '{
      "fields": [
        {"name": "id", "type": "string", "indexed": true, "stored": true},
        {"name": "timestamp", "type": "u64", "indexed": true, "stored": true},
        {"name": "level", "type": "string", "indexed": true, "stored": true},
        {"name": "message", "type": "text", "indexed": true, "stored": true}
      ],
      "default_search_fields": ["message"]
    }'

    let config = match TantivyConfig.new(path) {
      case Ok(c) -> c
      case Error(_) -> {
        cleanup_test_index(path)
        t.true(false)
        return
      }
    }

    let config_with_schema = match config.with_schema_json(schema_json) {
      case Ok(c) -> c
      case Error(_) -> {
        cleanup_test_index(path)
        t.true(false)
        return
      }
    }

    let mut manager = TantivyIndexManager.new(config_with_schema)

    match manager.open {
      case Ok(_) -> {
        let fields = [
          ('timestamp', '1704067200'),
          ('level', 'INFO'),
          ('message', 'Application started successfully'),
        ]

        match manager.add_doc('log-1', fields) {
          case Ok(_) -> t.true(true)
          case Error(_) -> t.true(false)
        }
      }
      case Error(_) -> t.true(false)
    }

    let _ = manager.close

    cleanup_test_index(path)
  })

  t.test('Schema with i64 integer fields', fn (t) {
    let path = temp_index_path('custom-schema-005')
    let schema_json = '{
      "fields": [
        {"name": "id", "type": "string", "indexed": true, "stored": true},
        {"name": "record_id", "type": "i64", "indexed": true, "stored": true},
        {"name": "name", "type": "text", "indexed": true, "stored": true}
      ],
      "default_search_fields": ["name"]
    }'

    let config = match TantivyConfig.new(path) {
      case Ok(c) -> c
      case Error(_) -> {
        cleanup_test_index(path)
        t.true(false)
        return
      }
    }

    let config_with_schema = match config.with_schema_json(schema_json) {
      case Ok(c) -> c
      case Error(_) -> {
        cleanup_test_index(path)
        t.true(false)
        return
      }
    }

    let mut manager = TantivyIndexManager.new(config_with_schema)

    match manager.open {
      case Ok(_) -> {
        let fields = [('record_id', '-12345'), ('name', 'Test Item')]

        match manager.add_doc('item-1', fields) {
          case Ok(_) -> t.true(true)
          case Error(_) -> t.true(false)
        }
      }
      case Error(_) -> t.true(false)
    }

    let _ = manager.close

    cleanup_test_index(path)
  })

  t.test('Schema validation rejects invalid JSON on open', fn (t) {
    let path = temp_index_path('custom-schema-006')
    let schema_json = '{invalid json'

    let config = match TantivyConfig.new(path) {
      case Ok(c) -> c
      case Error(_) -> {
        cleanup_test_index(path)
        t.true(false)
        return
      }
    }

    # with_schema_json stores the schema without validation
    let config_with_schema = match config.with_schema_json(schema_json) {
      case Ok(c) -> c
      case Error(_) -> {
        # If it rejects here, that's also acceptable
        cleanup_test_index(path)
        t.true(true)
        return
      }
    }

    # Validation happens at open time
    let mut manager = TantivyIndexManager.new(config_with_schema)

    match manager.open {
      case Ok(_) -> {
        let _ = manager.close

        cleanup_test_index(path)
        t.true(false)
      }
      case Error(_) -> {
        cleanup_test_index(path)
        t.true(true)
      }
    }
  })

  t.test('Multi-field search with custom schema', fn (t) {
    let path = temp_index_path('custom-schema-007')
    let schema_json = '{
      "fields": [
        {"name": "id", "type": "string", "indexed": true, "stored": true},
        {"name": "title", "type": "text", "indexed": true, "stored": true},
        {"name": "author", "type": "string", "indexed": true, "stored": true},
        {"name": "content", "type": "text", "indexed": true, "stored": true}
      ],
      "default_search_fields": ["title", "content"]
    }'

    let config = match TantivyConfig.new(path) {
      case Ok(c) -> c
      case Error(_) -> {
        cleanup_test_index(path)
        t.true(false)
        return
      }
    }

    let config_with_schema = match config.with_schema_json(schema_json) {
      case Ok(c) -> c
      case Error(_) -> {
        cleanup_test_index(path)
        t.true(false)
        return
      }
    }

    let mut manager = TantivyIndexManager.new(config_with_schema)

    match manager.open {
      case Ok(_) -> {
        let fields1 = [
          ('title', 'Search Engines'),
          ('author', 'John Doe'),
          ('content', 'Introduction to search technology'),
        ]

        let fields2 = [
          ('title', 'Database Systems'),
          ('author', 'Jane Smith'),
          ('content', 'Fundamentals of database management'),
        ]

        let _ = manager.add_doc('doc-1', fields1)
        let _ = manager.add_doc('doc-2', fields2)
        let _ = manager.commit

        match manager.search('search', 10, 0) {
          case Ok(results) -> {
            if results.size > 0 { t.true(true) } else { t.true(false) }
          }
          case Error(_) -> t.true(false)
        }
      }
      case Error(_) -> t.true(false)
    }

    let _ = manager.close

    cleanup_test_index(path)
  })

  t.test('String field for exact match', fn (t) {
    let path = temp_index_path('custom-schema-008')
    let schema_json = '{
      "fields": [
        {"name": "id", "type": "string", "indexed": true, "stored": true},
        {"name": "title", "type": "text", "indexed": true, "stored": true}
      ],
      "default_search_fields": ["title"]
    }'

    let config = match TantivyConfig.new(path) {
      case Ok(c) -> c
      case Error(_) -> {
        cleanup_test_index(path)
        t.true(false)
        return
      }
    }

    let config_with_schema = match config.with_schema_json(schema_json) {
      case Ok(c) -> c
      case Error(_) -> {
        cleanup_test_index(path)
        t.true(false)
        return
      }
    }

    let mut manager = TantivyIndexManager.new(config_with_schema)

    match manager.open {
      case Ok(_) -> {
        let fields = [('id', 'EXACT-ID-123'), ('title', 'Test Document')]

        match manager.add_doc('doc-1', fields) {
          case Ok(_) -> t.true(true)
          case Error(_) -> t.true(false)
        }
      }
      case Error(_) -> t.true(false)
    }

    let _ = manager.close

    cleanup_test_index(path)
  })

  t.test('Schema mismatch: string value for u64 field returns error', fn (t) {
    let path = temp_index_path('schema-mismatch-001')
    let schema_json = '{
      "fields": [
        {"name": "id", "type": "string", "indexed": true, "stored": true},
        {"name": "title", "type": "text", "indexed": true, "stored": true},
        {"name": "count", "type": "u64", "indexed": true, "stored": true}
      ],
      "default_search_fields": ["title"]
    }'

    let config = match TantivyConfig.new(path) {
      case Ok(c) -> c
      case Error(_) -> {
        cleanup_test_index(path)
        t.true(false)
        return
      }
    }

    let config_with_schema = match config.with_schema_json(schema_json) {
      case Ok(c) -> c
      case Error(_) -> {
        cleanup_test_index(path)
        t.true(false)
        return
      }
    }

    let mut manager = TantivyIndexManager.new(config_with_schema)

    match manager.open {
      case Ok(_) -> {
        # String value for u64 field - returns an error (type mismatch)
        let fields = [('title', 'Test'), ('count', 'not-a-number')]

        match manager.add_doc('doc-1', fields) {
          case Ok(_) -> t.true(false)
          case Error(e) -> {
            t.true(
              e.contains?('u64')
                or e.contains?('not a valid')
                or e.contains?('count'),
            )
          }
        }
      }
      case Error(_) -> t.true(false)
    }

    let _ = manager.close

    cleanup_test_index(path)
  })

  t.test('Schema mismatch: string value for bool field', fn (t) {
    let path = temp_index_path('schema-mismatch-002')
    let schema_json = '{
      "fields": [
        {"name": "id", "type": "string", "indexed": true, "stored": true},
        {"name": "title", "type": "text", "indexed": true, "stored": true},
        {"name": "active", "type": "bool", "indexed": true, "stored": true}
      ],
      "default_search_fields": ["title"]
    }'

    let config = match TantivyConfig.new(path) {
      case Ok(c) -> c
      case Error(_) -> {
        cleanup_test_index(path)
        t.true(false)
        return
      }
    }

    let config_with_schema = match config.with_schema_json(schema_json) {
      case Ok(c) -> c
      case Error(_) -> {
        cleanup_test_index(path)
        t.true(false)
        return
      }
    }

    let mut manager = TantivyIndexManager.new(config_with_schema)

    match manager.open {
      case Ok(_) -> {
        # Non-boolean string for bool field
        let fields = [('title', 'Test'), ('active', 'maybe')]

        match manager.add_doc('doc-1', fields) {
          case Ok(_) -> {
            # Should succeed - 'maybe' is treated as false (not 'true')
            let _ = manager.commit

            match manager.get_doc('doc-1') {
              case Ok(_) -> t.true(true)
              case Error(_) -> t.true(false)
            }
          }
          case Error(_) -> t.true(false)
        }
      }
      case Error(_) -> t.true(false)
    }

    let _ = manager.close

    cleanup_test_index(path)
  })

  t.test('Schema mismatch: field not in schema is silently skipped', fn (t) {
    let path = temp_index_path('schema-mismatch-003')
    let schema_json = '{
      "fields": [
        {"name": "id", "type": "string", "indexed": true, "stored": true},
        {"name": "title", "type": "text", "indexed": true, "stored": true}
      ],
      "default_search_fields": ["title"]
    }'

    let config = match TantivyConfig.new(path) {
      case Ok(c) -> c
      case Error(_) -> {
        cleanup_test_index(path)
        t.true(false)
        return
      }
    }

    let config_with_schema = match config.with_schema_json(schema_json) {
      case Ok(c) -> c
      case Error(_) -> {
        cleanup_test_index(path)
        t.true(false)
        return
      }
    }

    let mut manager = TantivyIndexManager.new(config_with_schema)

    match manager.open {
      case Ok(_) -> {
        # unknown_field is not in schema
        let fields = [('title', 'Test'), ('unknown_field', 'value')]

        match manager.add_doc('doc-1', fields) {
          case Ok(_) -> {
            let _ = manager.commit

            match manager.get_doc('doc-1') {
              case Ok(doc) -> {
                # Should have title but not unknown_field
                t.true(doc.contains?('Test'))
              }
              case Error(_) -> t.true(false)
            }
          }
          case Error(_) -> t.true(false)
        }
      }
      case Error(_) -> t.true(false)
    }

    let _ = manager.close

    cleanup_test_index(path)
  })
}
