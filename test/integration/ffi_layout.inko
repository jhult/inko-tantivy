#
# FFI struct layout, alignment, and backward compatibility tests
# These tests ensure FFI struct definitions match the Rust implementation exactly

import std.test (Tests)
import tantivy.ffi (
  AGGREGATION_OFFSET_COUNT, AGGREGATION_OFFSET_KEY, AGGREGATION_SIZE,
  CONFIG_OFFSET_PATH, CONFIG_OFFSET_READER_MEMORY, CONFIG_OFFSET_SCHEMA_JSON,
  CONFIG_OFFSET_THREADS, CONFIG_OFFSET_WRITER_MEMORY, CONFIG_SIZE,
  FIELD_OFFSET_KEY, FIELD_OFFSET_VALUE, FIELD_SIZE, PTR_SIZE,
  RESULT_OFFSET_DOC_ID, RESULT_OFFSET_HIGHLIGHT, RESULT_OFFSET_SCORE,
  RESULT_SIZE, SUGGESTION_OFFSET_SCORE, SUGGESTION_OFFSET_TEXT, SUGGESTION_SIZE,
)

fn pub tests(t: mut Tests) {
  # Verify FFI struct layout constants
  # These constants must match the Rust struct definitions exactly
  # If this test fails, run the Rust test: cargo test print_ffi_struct_layouts
  # to see the actual struct sizes and offsets

  t.test('FFI struct layout: TantivyConfig', fn (t) {
    t.equal(CONFIG_SIZE, 40)
    t.equal(CONFIG_OFFSET_PATH, 0)
    t.equal(CONFIG_OFFSET_READER_MEMORY, 8)
    t.equal(CONFIG_OFFSET_WRITER_MEMORY, 16)
    t.equal(CONFIG_OFFSET_THREADS, 24)
    t.equal(CONFIG_OFFSET_SCHEMA_JSON, 32)
  })

  t.test('FFI struct layout: TantivyResult', fn (t) {
    t.equal(RESULT_SIZE, 24)
    t.equal(RESULT_OFFSET_DOC_ID, 0)
    t.equal(RESULT_OFFSET_SCORE, 8)
    t.equal(RESULT_OFFSET_HIGHLIGHT, 16)
  })

  t.test('FFI struct layout: TantivyAggregationResult', fn (t) {
    t.equal(AGGREGATION_SIZE, 16)
    t.equal(AGGREGATION_OFFSET_KEY, 0)
    t.equal(AGGREGATION_OFFSET_COUNT, 8)
  })

  t.test('FFI struct layout: TantivySuggestion', fn (t) {
    t.equal(SUGGESTION_SIZE, 16)
    t.equal(SUGGESTION_OFFSET_TEXT, 0)
    t.equal(SUGGESTION_OFFSET_SCORE, 8)
  })

  t.test('FFI struct layout: DocField', fn (t) {
    t.equal(FIELD_SIZE, 16)
    t.equal(FIELD_OFFSET_KEY, 0)
    t.equal(FIELD_OFFSET_VALUE, 8)
  })

  t.test('FFI struct layout: Pointer size', fn (t) { t.equal(PTR_SIZE, 8) })

  # Memory alignment tests
  # All struct fields must be 8-byte aligned for 64-bit pointer access
  # Misalignment causes segfaults on ARM64 and performance issues on x86-64

  t.test('alignment: TantivyConfig fields are 8-byte aligned', fn (t) {
    t.equal(CONFIG_OFFSET_PATH % 8, 0)
    t.equal(CONFIG_OFFSET_READER_MEMORY % 8, 0)
    t.equal(CONFIG_OFFSET_WRITER_MEMORY % 8, 0)
    t.equal(CONFIG_OFFSET_THREADS % 8, 0)
    t.equal(CONFIG_OFFSET_SCHEMA_JSON % 8, 0)
  })

  t.test('alignment: TantivyResult fields are 8-byte aligned', fn (t) {
    t.equal(RESULT_OFFSET_DOC_ID % 8, 0)
    t.equal(RESULT_OFFSET_SCORE % 8, 0)
    t.equal(RESULT_OFFSET_HIGHLIGHT % 8, 0)
  })

  t.test(
    'alignment: TantivyAggregationResult fields are 8-byte aligned',
    fn (t) {
      t.equal(AGGREGATION_OFFSET_KEY % 8, 0)
      t.equal(AGGREGATION_OFFSET_COUNT % 8, 0)
    },
  )

  t.test('alignment: TantivySuggestion fields are 8-byte aligned', fn (t) {
    t.equal(SUGGESTION_OFFSET_TEXT % 8, 0)
    t.equal(SUGGESTION_OFFSET_SCORE % 8, 0)
  })

  t.test('alignment: DocField fields are 8-byte aligned', fn (t) {
    t.equal(FIELD_OFFSET_KEY % 8, 0)
    t.equal(FIELD_OFFSET_VALUE % 8, 0)
  })

  t.test('alignment: struct sizes are multiples of 8', fn (t) {
    t.equal(CONFIG_SIZE % 8, 0)
    t.equal(RESULT_SIZE % 8, 0)
    t.equal(AGGREGATION_SIZE % 8, 0)
    t.equal(SUGGESTION_SIZE % 8, 0)
    t.equal(FIELD_SIZE % 8, 0)
  })

  # Backward compatibility tests
  # These struct layouts MUST remain stable across versions
  # Changing these values breaks FFI compatibility with existing C libraries
  # If you need to change the struct layout, create a new version of the FFI interface

  t.test('backward compatibility: TantivyConfig layout is stable', fn (t) {
    t.equal(CONFIG_SIZE, 40)
    t.equal(CONFIG_OFFSET_PATH, 0)
    t.equal(CONFIG_OFFSET_READER_MEMORY, 8)
    t.equal(CONFIG_OFFSET_WRITER_MEMORY, 16)
    t.equal(CONFIG_OFFSET_THREADS, 24)
    t.equal(CONFIG_OFFSET_SCHEMA_JSON, 32)
  })

  t.test('backward compatibility: TantivyResult layout is stable', fn (t) {
    t.equal(RESULT_SIZE, 24)
    t.equal(RESULT_OFFSET_DOC_ID, 0)
    t.equal(RESULT_OFFSET_SCORE, 8)
    t.equal(RESULT_OFFSET_HIGHLIGHT, 16)
  })

  t.test(
    'backward compatibility: TantivyAggregationResult layout is stable',
    fn (t) {
      t.equal(AGGREGATION_SIZE, 16)
      t.equal(AGGREGATION_OFFSET_KEY, 0)
      t.equal(AGGREGATION_OFFSET_COUNT, 8)
    },
  )

  t.test('backward compatibility: TantivySuggestion layout is stable', fn (t) {
    t.equal(SUGGESTION_SIZE, 16)
    t.equal(SUGGESTION_OFFSET_TEXT, 0)
    t.equal(SUGGESTION_OFFSET_SCORE, 8)
  })

  t.test('backward compatibility: DocField layout is stable', fn (t) {
    t.equal(FIELD_SIZE, 16)
    t.equal(FIELD_OFFSET_KEY, 0)
    t.equal(FIELD_OFFSET_VALUE, 8)
  })
}
