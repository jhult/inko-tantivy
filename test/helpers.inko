# Shared test helper functions

import std.env
import std.fs.path (Path)
import tantivy.index_manager (TantivyIndexManager)

# Get platform-appropriate temp directory
fn pub get_temp_dir -> String {
  match env.get('TMPDIR') {
    case Ok(path) -> trim_trailing_slash(path.trim)
    case Error(_) -> {
      match env.get('TEMP') {
        case Ok(path) -> trim_trailing_slash(path.trim)
        case Error(_) -> {
          match env.get('TMP') {
            case Ok(path) -> trim_trailing_slash(path.trim)
            case Error(_) -> '/tmp'
          }
        }
      }
    }
  }
}

# Helper to remove trailing slashes from path
fn pub trim_trailing_slash(path: String) -> String {
  if path.size > 0 {
    match path.get(path.size - 1) {
      case Ok(byte) -> {
        if byte.to_int == 47 { return path.substring(0, path.size - 1) }
      }
      case Error(_) -> {}
    }
  }

  path
}

# Helper to create a temporary test index directory
# Takes a unique identifier (e.g., test name or number) to avoid conflicts
fn pub temp_index_path(unique_id: String) -> String {
  '${get_temp_dir}/tantivy-test-${unique_id}'
}

# Check if FFI backend is available and working
# Uses TantivyIndexManager.ffi_available which is much more efficient than creating an index
fn pub ffi_available -> Bool {
  TantivyIndexManager.ffi_available == 1
}

# Helper to clean up test index
fn pub cleanup_test_index(path: String) {
  let p = Path.new(path)
  match p.remove_directory_all {
    case Ok(_) -> {}
    case Error(_) -> {
      # Silently ignore cleanup errors - directory may not exist or be locked
      # This prevents cascading test failures
    }
  }
}
