import std.stdio (Stdout)

type pub BenchmarkStats {
  let @name: String
  let @iterations: Int
  let @warmup_runs: Int
  let mut @total_duration_ns: Int
  let mut @durations: Array[Int]
}

impl BenchmarkStats {
  fn pub static new(
    name: String,
    iterations: Int,
    warmup_runs: Int,
  ) -> BenchmarkStats {
    BenchmarkStats(
      name: name,
      iterations: iterations,
      warmup_runs: warmup_runs,
      total_duration_ns: 0,
      durations: [],
    )
  }

  fn pub mean -> Int {
    if @durations.size == 0 { return 0 }

    @total_duration_ns / @durations.size
  }

  fn pub median -> Int {
    if @durations.size == 0 { return 0 }

    let mut sorted = @durations.clone

    sorted.sort

    let mid = sorted.size / 2

    if sorted.size % 2 == 0 {
      (sorted.get(mid).or_panic + sorted.get(mid - 1).or_panic) / 2
    } else {
      sorted.get(mid).or_panic
    }
  }

  fn pub percentile(percent: Int) -> Int {
    if @durations.size == 0 { return 0 }

    if percent < 0 or percent > 100 { return mean }

    let mut sorted = @durations.clone

    sorted.sort

    let index = (percent * (sorted.size - 1)) / 100

    sorted.get(index).or_panic
  }

  fn pub p95 -> Int {
    percentile(95)
  }

  fn pub p99 -> Int {
    percentile(99)
  }

  fn pub min -> Int {
    if @durations.size == 0 { return 0 }

    let mut min_val = @durations.get(0).or_panic

    for d in @durations.iter {
      if d < min_val { min_val = d }
    }

    min_val
  }

  fn pub max -> Int {
    if @durations.size == 0 { return 0 }

    let mut max_val = @durations.get(0).or_panic

    for d in @durations.iter {
      if d > max_val { max_val = d }
    }

    max_val
  }

  fn pub variance -> Float {
    if @durations.size < 2 { return 0.0 }

    let mean_val = mean as Float
    let mut sum_sq_diff = 0.0

    for d in @durations.iter {
      let diff = d as Float - mean_val

      sum_sq_diff = sum_sq_diff + (diff * diff)
    }

    sum_sq_diff / ((@durations.size - 1) as Float)
  }

  fn pub std_dev -> Float {
    sqrt(variance)
  }

  fn ns_to_ms(ns: Int) -> Float {
    ns as Float / 1_000_000.0
  }

  fn pub print_results {
    let mean_ns = mean
    let median_ns = median
    let p95_ns = p95
    let p99_ns = p99
    let min_ns = min
    let max_ns = max
    let std_dev_val = std_dev
    let out = Stdout.new

    let _ = out.print('')
    let _ = out.print('=== ${@name} ===')
    let _ = out.print('Iterations: ${@iterations}')
    let _ = out.print('Warmup runs: ${@warmup_runs}')
    let _ = out.print('')
    let _ = out.print('Latency Statistics:')
    let _ = out.print('  Mean:   ${ns_to_ms(mean_ns)}ms (${mean_ns}ns)')
    let _ = out.print('  Median: ${ns_to_ms(median_ns)}ms (${median_ns}ns)')
    let _ = out.print('  P95:    ${ns_to_ms(p95_ns)}ms (${p95_ns}ns)')
    let _ = out.print('  P99:    ${ns_to_ms(p99_ns)}ms (${p99_ns}ns)')
    let _ = out.print('  Min:    ${ns_to_ms(min_ns)}ms (${min_ns}ns)')
    let _ = out.print('  Max:    ${ns_to_ms(max_ns)}ms (${max_ns}ns)')
    let _ = out.print(
      '  StdDev: ${std_dev_val / 1_000_000.0}ms (${std_dev_val}ns)',
    )
    let _ = out.print('')
    let _ = out.print(
      'Throughput: ${(1_000_000_000.0 / (mean_ns as Float)).to_int} ops/sec',
    )
    let _ = out.print('')
  }
}

fn pub sqrt(n: Float) -> Float {
  if n < 0.0 { return 0.0 }

  if n == 0.0 { return 0.0 }

  let mut x = n
  let mut i = 0

  while i < 20 {
    x = (x + n / x) / 2.0
    i = i + 1
  }

  x
}
