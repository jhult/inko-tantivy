# Benchmark: Paginated search
fn bench_paginated_search {
  let manager = setup_index('/tmp/bench-paginated')

  Stdout.new.print('Running: Paginated search (offset 100)')
  Stdout.new.print('Warmup runs: 10')

  let mut i = 0

  while i < 10 {
    let _ = manager.search('topic', 10, 100)

    i = i + 1
  }

  Stdout.new.print('Benchmark runs: 500')
  Stdout.new.print('')

  let mut durations = []
  let mut total_duration_ns = 0
  let mut j = 0

  while j < 500 {
    let start = Instant.new

    match manager.search('topic', 10, 100) {
      case Ok(_) -> {}
      case Error(e) -> Stdout.new.print('Error during benchmark: ${e}')
    }

    let elapsed = start.elapsed.to_nanos

    total_duration_ns = total_duration_ns + elapsed
    durations.push(elapsed)

    j = j + 1

    if j % 100 == 0 { Stdout.new.print('  Progress: ${j}/500') }
  }

  let mut stats = BenchmarkStats.new('Paginated search (offset 100)', 500, 10)

  stats.total_duration_ns = total_duration_ns
  stats.durations = durations
  stats.print_results

  let mut tracker = MemoryTracker.new('Paginated search')

  tracker.start

  let query_bytes_per_op = 10 + 1
  let result_bytes_per_op = 24 * 10
  let total_bytes = (query_bytes_per_op + result_bytes_per_op) * 500

  tracker.record_allocation('query_buffers', query_bytes_per_op * 500)
  tracker.record_allocation('result_objects', result_bytes_per_op * 500)

  tracker.stop

  Stdout.new.print('')
  Stdout.new.print('Memory allocations:')
  tracker.print_summary

  let _ = manager.close
}

type async Main {
  fn async main {
    Stdout.new.print('========================================')
    Stdout.new.print('  Search Benchmarks with Statistics')
    Stdout.new.print('========================================')
    Stdout.new.print('')
    Stdout.new.print('Methodology:')
    Stdout.new.print(
      '  1. Warmup runs: Executes operation N times to warm up caches',
    )
    Stdout.new.print(
      '  2. Benchmark runs: Executes operation N times and measures each',
    )
    Stdout.new.print(
      '  3. Statistics: Calculates mean, median, p95, p99, std dev',
    )
    Stdout.new.print(
      '  4. Outliers: Min/max help identify performance anomalies',
    )
    Stdout.new.print('')
    Stdout.new.print('Interpreting Results:')
    Stdout.new.print('  - Mean: Average performance across all runs')
    Stdout.new.print(
      '  - Median: Typical performance (less affected by outliers)',
    )
    Stdout.new.print('  - P95: 95% of runs completed faster than this')
    Stdout.new.print('  - P99: 99% of runs completed faster than this')
    Stdout.new.print(
      '  - StdDev: Variability in performance (lower = more consistent)',
    )
    Stdout.new.print('')
    Stdout.new.print('Regression Detection:')
    Stdout.new.print(
      '  - Watch P95 and P99 for increases (indicates worst-case degradation)',
    )
    Stdout.new.print(
      '  - Watch median for increases (indicates typical performance)',
    )
    Stdout.new.print(
      '  - Compare std_dev across versions (higher = more variability)',
    )
    Stdout.new.print('')
    Stdout.new.print('========================================')
    Stdout.new.print('')

    bench_simple_search
    bench_complex_search
    bench_autocomplete
    bench_paginated_search

    Stdout.new.print('========================================')
    Stdout.new.print('  All Benchmarks Complete')
    Stdout.new.print('========================================')
  }
}
