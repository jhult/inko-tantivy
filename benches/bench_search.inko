# Performance benchmarks for search operations

import memory_tracker (MemoryTracker)
import std.stdio (Stdout)
import std.time (Duration, Instant)
import tantivy.index_manager (TantivyIndexManager)
import tantivy.query_builder (TantivyQueryBuilder)
import tantivy.types (TantivyConfig)

# Benchmark statistics
type BenchmarkStats {
  let @name: String
  let @iterations: Int
  let @warmup_runs: Int
  let mut @total_duration_ns: Int
  let mut @durations: Array[Int]
}

impl BenchmarkStats {
  fn pub static new(
    name: String,
    iterations: Int,
    warmup_runs: Int,
  ) -> BenchmarkStats {
    BenchmarkStats(
      name: name,
      iterations: iterations,
      warmup_runs: warmup_runs,
      total_duration_ns: 0,
      durations: [],
    )
  }

  # Calculate mean (average) duration in nanoseconds
  fn pub mean -> Int {
    if @durations.size == 0 { return 0 }

    @total_duration_ns / @durations.size
  }

  # Calculate median duration (50th percentile)
  fn pub median -> Int {
    if @durations.size == 0 { return 0 }

    let mut sorted = @durations.clone

    sorted.sort

    let sorted = sorted

    let mid = sorted.size / 2

    if sorted.size % 2 == 0 {
      match sorted.get(mid) {
        case Ok(v1) -> {
          match sorted.get(mid - 1) {
            case Ok(v2) -> (v1 + v2) / 2
            case Error(_) -> 0
          }
        }
        case Error(_) -> 0
      }
    } else {
      match sorted.get(mid) {
        case Ok(v) -> v
        case Error(_) -> 0
      }
    }
  }

  # Calculate percentile (0-100)
  fn pub percentile(percent: Int) -> Int {
    if @durations.size == 0 { return 0 }

    if percent < 0 or percent > 100 { return mean }

    let mut sorted = @durations.clone

    sorted.sort

    let index = (percent * (sorted.size - 1)) / 100

    match sorted.get(index) {
      case Ok(v) -> v
      case Error(_) -> mean
    }
  }

  # Get p95 (95th percentile)
  fn pub p95 -> Int {
    percentile(95)
  }

  # Get p99 (99th percentile)
  fn pub p99 -> Int {
    percentile(99)
  }

  # Calculate variance (std dev squared)
  fn pub variance -> Float {
    if @durations.size < 2 { return 0.0 }

    let mean_val = mean as Float
    let mut sum_sq_diff = 0.0

    for d in @durations.iter {
      let diff = d as Float - mean_val

      sum_sq_diff = sum_sq_diff + (diff * diff)
    }

    let denom = (@durations.size - 1) as Float

    sum_sq_diff / denom
  }

  # Calculate standard deviation (use sqrt for now - may need external implementation)
  fn pub std_dev -> Float {
    variance
  }

  # Calculate min duration
  fn pub min -> Int {
    if @durations.size == 0 { return 0 }

    let mut min_val = @durations.get(0).or_panic

    for d in @durations.iter {
      if d < min_val { min_val = d }
    }

    min_val
  }

  # Calculate max duration
  fn pub max -> Int {
    if @durations.size == 0 { return 0 }

    let mut max_val = @durations.get(0).or_panic

    for d in @durations.iter {
      if d > max_val { max_val = d }
    }

    max_val
  }

  # Convert nanoseconds to milliseconds
  fn ns_to_ms(ns: Int) -> Float {
    ns as Float / 1_000_000.0
  }

  # Format and print results
  fn pub print_results {
    let mean_ns = mean
    let median_ns = median
    let p95_ns = p95
    let p99_ns = p99
    let min_ns = min
    let max_ns = max
    let std_dev_val = std_dev

    Stdout.new.print('')
    Stdout.new.print('=== ${@name} ===')
    Stdout.new.print('Iterations: ${@iterations}')
    Stdout.new.print('Warmup runs: ${@warmup_runs}')
    Stdout.new.print('')
    Stdout.new.print('Latency Statistics:')
    Stdout.new.print('  Mean:   ${ns_to_ms(mean_ns)}ms (${mean_ns}ns)')
    Stdout.new.print('  Median: ${ns_to_ms(median_ns)}ms (${median_ns}ns)')
    Stdout.new.print('  P95:    ${ns_to_ms(p95_ns)}ms (${p95_ns}ns)')
    Stdout.new.print('  P99:    ${ns_to_ms(p99_ns)}ms (${p99_ns}ns)')
    Stdout.new.print('  Min:    ${ns_to_ms(min_ns)}ms (${min_ns}ns)')
    Stdout.new.print('  Max:    ${ns_to_ms(max_ns)}ms (${max_ns}ns)')
    Stdout.new.print('  StdDev: ${std_dev_val}ms')
    Stdout.new.print('')
    Stdout.new.print(
      'Throughput: ${(1_000_000_000.0 / ns_to_ms(mean_ns)).to_int} ops/sec',
    )
    Stdout.new.print('')
  }
}

# Setup: Create index with test data
fn setup_index(path: String) -> TantivyIndexManager {
  let config = match TantivyConfig.new(path) {
    case Ok(c) -> c
    case Error(e) -> {
      Stdout.new.print('Failed to create config: ${e}')
      panic('Config error')
    }
  }
  let manager = TantivyIndexManager.new(config)

  match manager.open {
    case Ok(_) -> {
      let mut i = 0

      while i < 1000 {
        let fields = [
          ('subject', 'Email about topic ${i % 10}'),
          ('from', 'user${i % 50}@example.com'),
          (
            'body',
            'Content discussing topic ${i % 10} with details about subject ${i}',
          ),
        ]

        let _ = manager.add_doc('search-doc-${i}', fields)

        i = i + 1
      }

      let _ = manager.commit

      manager
    }
    case Error(e) -> {
      Stdout.new.print('Failed to setup index: ${e}')
      manager
    }
  }
}

# Benchmark: Simple term search
fn bench_simple_search {
  let manager = setup_index('/tmp/bench-simple-search')

  Stdout.new.print('Running: Simple term search')
  Stdout.new.print('Warmup runs: 10')

  let mut i = 0

  while i < 10 {
    let _ = manager.search('topic', 10, 0)

    i = i + 1
  }

  Stdout.new.print('Benchmark runs: 500')
  Stdout.new.print('')

  let mut durations = []
  let mut total_duration_ns = 0
  let mut j = 0

  while j < 500 {
    let start = Instant.new

    match manager.search('topic', 10, 0) {
      case Ok(_) -> {}
      case Error(e) -> Stdout.new.print('Error during benchmark: ${e}')
    }

    let elapsed = start.elapsed.to_nanos

    total_duration_ns = total_duration_ns + elapsed
    durations.push(elapsed)

    j = j + 1

    if j % 100 == 0 { Stdout.new.print('  Progress: ${j}/500') }
  }

  let mut stats = BenchmarkStats.new('Simple term search', 500, 10)

  stats.total_duration_ns = total_duration_ns
  stats.durations = durations
  stats.print_results

  let mut tracker = MemoryTracker.new('Simple term search')

  tracker.start

  let query_bytes_per_op = 10 + 1
  let result_bytes_per_op = 24 * 10
  let total_bytes = (query_bytes_per_op + result_bytes_per_op) * 500

  tracker.record_allocation('query_buffers', query_bytes_per_op * 500)
  tracker.record_allocation('result_objects', result_bytes_per_op * 500)

  tracker.stop

  Stdout.new.print('')
  Stdout.new.print('Memory allocations:')
  tracker.print_summary

  let _ = manager.close
}

# Benchmark: Complex query with multiple terms
fn bench_complex_search {
  let manager = setup_index('/tmp/bench-complex-search')

  Stdout.new.print('Running: Complex query search')
  Stdout.new.print('Warmup runs: 10')

  let mut i = 0

  while i < 10 {
    let query = TantivyQueryBuilder.new

    query.search_text('body', 'topic')
    query.search_text('subject', 'Email')

    let _ = manager.search(query.build, 10, 0)

    i = i + 1
  }

  Stdout.new.print('Benchmark runs: 500')
  Stdout.new.print('')

  let mut durations = []
  let mut total_duration_ns = 0
  let mut j = 0

  while j < 500 {
    let start = Instant.new

    let query = TantivyQueryBuilder.new

    query.search_text('body', 'topic')
    query.search_text('subject', 'Email')

    match manager.search(query.build, 10, 0) {
      case Ok(_) -> {}
      case Error(e) -> Stdout.new.print('Error during benchmark: ${e}')
    }

    let elapsed = start.elapsed.to_nanos

    total_duration_ns = total_duration_ns + elapsed
    durations.push(elapsed)

    j = j + 1

    if j % 100 == 0 { Stdout.new.print('  Progress: ${j}/500') }
  }

  let mut stats = BenchmarkStats.new('Complex query search', 500, 10)

  stats.total_duration_ns = total_duration_ns
  stats.durations = durations
  stats.print_results

  let mut tracker = MemoryTracker.new('Complex query search')

  tracker.start

  let query_bytes_per_op = 4 + 5 + 5 + 1
  let result_bytes_per_op = 24 * 10
  let total_bytes = (query_bytes_per_op + result_bytes_per_op) * 500

  tracker.record_allocation('query_buffers', query_bytes_per_op * 500)
  tracker.record_allocation('result_objects', result_bytes_per_op * 500)

  tracker.stop

  Stdout.new.print('')
  Stdout.new.print('Memory allocations:')
  tracker.print_summary

  let _ = manager.close
}

