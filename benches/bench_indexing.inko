# Performance benchmarks for document indexing operations

import benchmark_stats (BenchmarkStats)
import std.fs.path (Path)
import std.stdio (Stdout)
import std.time (Duration, Instant)
import tantivy.index_manager (TantivyIndexManager)
import tantivy.types (TantivyConfig)

# Benchmark paths used (for cleanup)
let BENCH_PATHS = [
  '/tmp/bench-single-doc',
  '/tmp/bench-batch-docs',
  '/tmp/bench-large-doc',
]

# Cleanup benchmark index directories
fn cleanup_benchmark_indexes {
  for path in BENCH_PATHS {
    let p = Path.new(path)
    let _ = p.remove_directory_all
  }
}

fn setup_index(path: String) -> TantivyIndexManager {
  let config = match TantivyConfig.new(path) {
    case Ok(c) -> c
    case Error(e) -> {
      Stdout.new.print('Failed to create config: ${e}')
      panic('Config error')
    }
  }
  let manager = TantivyIndexManager.new(config)

  match manager.open {
    case Ok(_) -> {
      let mut i = 0

      while i < 1000 {
        let fields = [
          ('subject', 'Email about topic ${i % 10}'),
          ('from', 'user${i % 50}@example.com'),
          (
            'body',
            'Content discussing topic ${i % 10} with details about subject ${i}',
          ),
        ]

        let _ = manager.add_doc('search-doc-${i}', fields)

        i = i + 1
      }

      let _ = manager.commit

      manager
    }
    case Error(e) -> {
      Stdout.new.print('Failed to setup index: ${e}')
      manager
    }
  }
}

fn bench_single_doc_indexing {
  let manager = setup_index('/tmp/bench-single-doc')

  Stdout.new.print('Running: Single document index')
  Stdout.new.print('Warmup runs: 5')

  let mut i = 0

  while i < 5 {
    let fields = [
      ('subject', 'Test email subject'),
      ('from', 'test@example.com'),
      ('body', 'This is a test email body with some content'),
    ]

    let _ = manager.add_doc('bench-doc-warmup-${i}', fields)

    i = i + 1
  }

  Stdout.new.print('Benchmark runs: 100')
  Stdout.new.print('')

  let mut durations = []
  let mut total_duration_ns = 0
  let mut j = 0

  while j < 100 {
    let start = Instant.new

    let fields = [
      ('subject', 'Test email subject'),
      ('from', 'test@example.com'),
      ('body', 'This is a test email body with some content'),
    ]

    match manager.add_doc('bench-doc-${j}', fields) {
      case Ok(_) -> {}
      case Error(e) -> Stdout.new.print('Error during benchmark: ${e}')
    }

    let elapsed = start.elapsed.to_nanos

    total_duration_ns = total_duration_ns + elapsed
    durations.push(elapsed)

    j = j + 1

    if j % 20 == 0 { Stdout.new.print('  Progress: ${j}/100') }
  }

  let mut stats = BenchmarkStats.new('Single document index', 100, 5)

  stats.total_duration_ns = total_duration_ns
  stats.durations = durations
  stats.print_results

  let _ = manager.close
}

fn bench_batch_doc_indexing {
  let manager = setup_index('/tmp/bench-batch-docs')

  Stdout.new.print('Running: Batch 100 documents')
  Stdout.new.print('Warmup runs: 5')

  let mut i = 0

  while i < 5 {
    let mut batch = []
    let mut k = 0

    while k < 100 {
      let doc_id = batch.size + k

      batch.push(
        (
          'bench-doc-warmup-${i}-${doc_id}',
          [
            ('subject', 'Email ${doc_id}'),
            ('from', 'user${doc_id}@example.com'),
            ('body', 'Body content for email number ${doc_id}'),
          ],
        ),
      )
      k = k + 1
    }

    let _ = manager.add_docs_batch(batch)

    i = i + 1
  }

  Stdout.new.print('Benchmark runs: 10')
  Stdout.new.print('')

  let mut durations = []
  let mut total_duration_ns = 0
  let mut j = 0

  while j < 10 {
    let start = Instant.new

    let mut batch = []
    let mut k = 0

    while k < 100 {
      let doc_id = batch.size + k

      batch.push(
        (
          'bench-doc-${j}-${doc_id}',
          [
            ('subject', 'Email ${doc_id}'),
            ('from', 'user${doc_id}@example.com'),
            ('body', 'Body content for email number ${doc_id}'),
          ],
        ),
      )
      k = k + 1
    }

    match manager.add_docs_batch(batch) {
      case Ok(_) -> {}
      case Error(e) -> Stdout.new.print('Error during benchmark: ${e}')
    }

    let elapsed = start.elapsed.to_nanos

    total_duration_ns = total_duration_ns + elapsed
    durations.push(elapsed)

    j = j + 1

    Stdout.new.print('  Progress: ${j}/10')
  }

  let mut stats = BenchmarkStats.new('Batch 100 documents', 10, 5)

  stats.total_duration_ns = total_duration_ns
  stats.durations = durations
  stats.print_results

  let _ = manager.close
}

fn bench_large_doc_indexing {
  let manager = setup_index('/tmp/bench-large-doc')

  Stdout.new.print('Running: Large document (10KB)')
  Stdout.new.print('Warmup runs: 5')

  let mut large_body = ''
  let mut k = 0

  while k < 1000 {
    large_body = large_body
      + 'This is a long paragraph of text that will be repeated many times. '

    k = k + 1
  }

  let mut i = 0

  while i < 5 {
    let fields = [
      ('subject', 'Large email test'),
      ('from', 'test@example.com'),
      ('body', large_body),
    ]

    let _ = manager.add_doc('large-doc-warmup-${i}', fields)

    i = i + 1
  }

  Stdout.new.print('Benchmark runs: 50')
  Stdout.new.print('')

  let mut durations = []
  let mut total_duration_ns = 0
  let mut j = 0

  while j < 50 {
    let start = Instant.new

    let fields = [
      ('subject', 'Large email test'),
      ('from', 'test@example.com'),
      ('body', large_body),
    ]

    match manager.add_doc('large-doc-${j}', fields) {
      case Ok(_) -> {}
      case Error(e) -> Stdout.new.print('Error during benchmark: ${e}')
    }

    let elapsed = start.elapsed.to_nanos

    total_duration_ns = total_duration_ns + elapsed
    durations.push(elapsed)

    j = j + 1

    if j % 10 == 0 { Stdout.new.print('  Progress: ${j}/50') }
  }

  let mut stats = BenchmarkStats.new('Large document (10KB)', 50, 5)

  stats.total_duration_ns = total_duration_ns
  stats.durations = durations
  stats.print_results

  let _ = manager.close
}

fn pub main {
  Stdout.new.print('========================================')
  Stdout.new.print('  Indexing Benchmarks with Statistics')
  Stdout.new.print('========================================')
  Stdout.new.print('')
  Stdout.new.print('Methodology:')
  Stdout.new.print(
    '  1. Warmup runs: Executes operation N times to warm up caches',
  )
  Stdout.new.print(
    '  2. Benchmark runs: Executes operation N times and measures each',
  )
  Stdout.new.print(
    '  3. Statistics: Calculates mean, median, p95, p99, std dev',
  )
  Stdout.new.print('  4. Outliers: Min/max help identify performance anomalies')
  Stdout.new.print('')
  Stdout.new.print('Interpreting Results:')
  Stdout.new.print('  - Mean: Average performance across all runs')
  Stdout.new.print(
    '  - Median: Typical performance (less affected by outliers)',
  )
  Stdout.new.print('  - P95: 95% of runs completed faster than this')
  Stdout.new.print('  - P99: 99% of runs completed faster than this')
  Stdout.new.print(
    '  - StdDev: Variability in performance (lower = more consistent)',
  )
  Stdout.new.print('')
  Stdout.new.print('Regression Detection:')
  Stdout.new.print(
    '  - Watch P95 and P99 for increases (indicates worst-case degradation)',
  )
  Stdout.new.print(
    '  - Watch median for increases (indicates typical performance)',
  )
  Stdout.new.print(
    '  - Compare std_dev across versions (higher = more variability)',
  )
  Stdout.new.print('')
  Stdout.new.print('========================================')
  Stdout.new.print('')

  bench_single_doc_indexing
  bench_batch_doc_indexing
  bench_large_doc_indexing

  cleanup_benchmark_indexes

  Stdout.new.print('========================================')
  Stdout.new.print('  All Benchmarks Complete')
  Stdout.new.print('========================================')
}
