# Performance benchmarks for aggregation and faceting operations

import benchmark_stats (BenchmarkStats)
import std.stdio (Stdout)
import std.time (Duration, Instant)
import tantivy.index_manager (TantivyIndexManager)
import tantivy.types (TantivyConfig)

fn setup_index(path: String) -> TantivyIndexManager {
  let config = match TantivyConfig.new(path) {
    case Ok(c) -> c
    case Error(e) -> {
      Stdout.new.print('Failed to create config: ${e}')
      panic('Config error')
    }
  }
  let manager = TantivyIndexManager.new(config)

  match manager.open {
    case Ok(_) -> {
      let mut i = 0

      while i < 5000 {
        let folder = 'folder${i % 20}'
        let label = 'label${i % 50}'

        let fields = [
          ('subject', 'Email ${i}'),
          ('from', 'user${i % 100}@example.com'),
          ('folder', folder),
          ('label', label),
          ('body', 'Content for email ${i}'),
        ]

        let _ = manager.add_doc('agg-doc-${i}', fields)

        i = i + 1
      }

      let _ = manager.commit

      manager
    }
    case Error(e) -> {
      Stdout.new.print('Failed to setup index: ${e}')
      manager
    }
  }
}

fn bench_facet_by_folder {
  let manager = setup_index('/tmp/bench-facet-folder')

  Stdout.new.print('Running: Facet by folder (20 buckets)')
  Stdout.new.print('Warmup runs: 10')

  let mut i = 0

  while i < 10 {
    let _ = manager.get_facet_counts('folder', '*')

    i = i + 1
  }

  Stdout.new.print('Benchmark runs: 200')
  Stdout.new.print('')

  let mut durations = []
  let mut total_duration_ns = 0
  let mut j = 0

  while j < 200 {
    let start = Instant.new

    match manager.get_facet_counts('folder', '*') {
      case Ok(_) -> {}
      case Error(e) -> Stdout.new.print('Error during benchmark: ${e}')
    }

    let elapsed = start.elapsed.to_nanos

    total_duration_ns = total_duration_ns + elapsed
    durations.push(elapsed)

    j = j + 1

    if j % 50 == 0 { Stdout.new.print('  Progress: ${j}/200') }
  }

  let mut stats = BenchmarkStats.new('Facet by folder (20 buckets)', 200, 10)

  stats.total_duration_ns = total_duration_ns
  stats.durations = durations
  stats.print_results

  let _ = manager.close
}

