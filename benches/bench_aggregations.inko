fn bench_faceted_search {
  let manager = setup_index('/tmp/bench-faceted-search')

  Stdout.new.print('Running: Faceted search with filter')
  Stdout.new.print('Warmup runs: 10')

  let mut i = 0

  while i < 10 {
    let _ = manager.get_facet_counts('label', 'folder:folder5')

    i = i + 1
  }

  Stdout.new.print('Benchmark runs: 200')
  Stdout.new.print('')

  let mut durations = []
  let mut total_duration_ns = 0
  let mut j = 0

  while j < 200 {
    let start = Instant.new

    match manager.get_facet_counts('label', 'folder:folder5') {
      case Ok(_) -> {}
      case Error(e) -> Stdout.new.print('Error during benchmark: ${e}')
    }

    let elapsed = start.elapsed.to_nanos

    total_duration_ns = total_duration_ns + elapsed
    durations.push(elapsed)

