import benchmark_stats (BenchmarkStats)
import std.fs.path (Path)
import std.stdio (Stdout)
import std.time (Duration, Instant)
import tantivy.index_manager (TantivyIndexManager)
import tantivy.types (TantivyConfig)

# Benchmark paths used (for cleanup)
let BENCH_PATHS = ['/tmp/bench-index']

# Cleanup benchmark index directories
fn cleanup_benchmark_indexes {
  for path in BENCH_PATHS {
    let p = Path.new(path)
    let _ = p.remove_directory_all
  }
}

fn benchmark_string_conversion(iterations: Int, warmup: Int) {
  let mut stats = BenchmarkStats.new(
    'string_to_c_buffer (allocation impact)',
    iterations,
    warmup,
  )

  let test_string = 'This is a test string with some length to measure allocation overhead'

  let mut i = 0

  while i < iterations + warmup {
    let start = Instant.new

    let _ = test_string.to_byte_array
    let _ = ByteArray.filled(with: 0, times: test_string.size + 1)

    let duration = start.elapsed.to_nanos

    if i >= warmup {
      let mut durations = stats.durations

      durations.push(duration)

      let mut total = stats.total_duration_ns

      total = total + duration
      stats = BenchmarkStats(
        name: stats.name,
        iterations: stats.iterations,
        warmup_runs: stats.warmup_runs,
        total_duration_ns: total,
        durations: durations,
      )
    }

    i = i + 1
  }

  Stdout.new.print('')
  Stdout.new.print(stats.name)
  Stdout.new.print('====================================')
  Stdout.new.print('Iterations: ${stats.iterations}')
  Stdout.new.print('Warmup runs: ${stats.warmup_runs}')
  Stdout.new.print('')
  Stdout.new.print('Latency (ns):')
  Stdout.new.print('  Mean:   ${stats.mean}')
  Stdout.new.print('  Median: ${stats.median}')
  Stdout.new.print('  Min:    ${stats.min}')
  Stdout.new.print('  Max:    ${stats.max}')
  Stdout.new.print('  Std Dev: ${stats.std_dev}')
  Stdout.new.print('')
}

fn benchmark_batch_indexing(iterations: Int, warmup: Int) {
  let mut stats = BenchmarkStats.new(
    'Batch indexing (100 docs x 10 fields)',
    iterations,
    warmup,
  )

  let test_index_path = '/tmp/bench-index'

  let mut i = 0

  while i < iterations + warmup {
    match TantivyConfig.new(test_index_path) {
      case Ok(config) -> {
        let mut manager = TantivyIndexManager.new(config)

        match manager.open {
          case Ok(_) -> {
            let start = Instant.new

            let mut j = 0

            while j < 100 {
              let doc_id = 'doc-${i}-${j}'

              let mut fields = []
              let mut k = 0

              while k < 10 {
                fields.push(('field_${k}', 'value_${i}_${j}_${k}'))
                k = k + 1
              }

              match manager.add_doc(doc_id, fields) {
                case Ok(_) -> {}
                case Error(_) -> {}
              }

              j = j + 1
            }

            let duration = start.elapsed.to_nanos

            if i >= warmup {
              let mut durations = stats.durations

              durations.push(duration)

              let mut total = stats.total_duration_ns

              total = total + duration
              stats = BenchmarkStats(
                name: stats.name,
                iterations: stats.iterations,
                warmup_runs: stats.warmup_runs,
                total_duration_ns: total,
                durations: durations,
              )
            }

            let _ = manager.close
          }
          case Error(_) -> {}
        }
      }
      case Error(_) -> {}
    }

    i = i + 1
  }

  Stdout.new.print('')
  Stdout.new.print(stats.name)
  Stdout.new.print('====================================')
  Stdout.new.print('Iterations: ${stats.iterations}')
  Stdout.new.print('Warmup runs: ${stats.warmup_runs}')
  Stdout.new.print('')
  Stdout.new.print('Latency (ns):')
  Stdout.new.print('  Mean:   ${stats.mean}')
  Stdout.new.print('  Median: ${stats.median}')
  Stdout.new.print('  Min:    ${stats.min}')
  Stdout.new.print('  Max:    ${stats.max}')
  Stdout.new.print('  Std Dev: ${stats.std_dev}')
  Stdout.new.print('')
}

fn benchmark_search_result_sizes(iterations: Int, warmup: Int) {
  let mut stats_small = BenchmarkStats.new(
    'Search (10 results)',
    iterations,
    warmup,
  )

  let mut stats_large = BenchmarkStats.new(
    'Search (1000 results)',
    iterations,
    warmup,
  )

  let test_index_path = '/tmp/bench-index'

  let mut i = 0

  while i < iterations + warmup {
    match TantivyConfig.new(test_index_path) {
      case Ok(config) -> {
        let mut manager = TantivyIndexManager.new(config)

        match manager.open {
          case Ok(_) -> {
            let start_small = Instant.new
            let _ = manager.search('test', 10, 0)
            let duration_small = start_small.elapsed.to_nanos

            let start_large = Instant.new
            let _ = manager.search('test', 1000, 0)
            let duration_large = start_large.elapsed.to_nanos

            if i >= warmup {
              let mut durations_small = stats_small.durations

              durations_small.push(duration_small)

              let mut total_small = stats_small.total_duration_ns

              total_small = total_small + duration_small
              stats_small = BenchmarkStats(
                name: stats_small.name,
                iterations: stats_small.iterations,
                warmup_runs: stats_small.warmup_runs,
                total_duration_ns: total_small,
                durations: durations_small,
              )

              let mut durations_large = stats_large.durations

              durations_large.push(duration_large)

              let mut total_large = stats_large.total_duration_ns

              total_large = total_large + duration_large
              stats_large = BenchmarkStats(
                name: stats_large.name,
                iterations: stats_large.iterations,
                warmup_runs: stats_large.warmup_runs,
                total_duration_ns: total_large,
                durations: durations_large,
              )
            }

            let _ = manager.close
          }
          case Error(_) -> {}
        }
      }
      case Error(_) -> {}
    }

    i = i + 1
  }

  Stdout.new.print('')
  Stdout.new.print(stats_small.name)
  Stdout.new.print('====================================')
  Stdout.new.print('Iterations: ${stats_small.iterations}')
  Stdout.new.print('Warmup runs: ${stats_small.warmup_runs}')
  Stdout.new.print('')
  Stdout.new.print('Latency (ns):')
  Stdout.new.print('  Mean:   ${stats_small.mean}')
  Stdout.new.print('  Median: ${stats_small.median}')
  Stdout.new.print('  Min:    ${stats_small.min}')
  Stdout.new.print('  Max:    ${stats_small.max}')
  Stdout.new.print('  Std Dev: ${stats_small.std_dev}')
  Stdout.new.print('')

  Stdout.new.print(stats_large.name)
  Stdout.new.print('====================================')
  Stdout.new.print('Iterations: ${stats_large.iterations}')
  Stdout.new.print('Warmup runs: ${stats_large.warmup_runs}')
  Stdout.new.print('')
  Stdout.new.print('Latency (ns):')
  Stdout.new.print('  Mean:   ${stats_large.mean}')
  Stdout.new.print('  Median: ${stats_large.median}')
  Stdout.new.print('  Min:    ${stats_large.min}')
  Stdout.new.print('  Max:    ${stats_large.max}')
  Stdout.new.print('  Std Dev: ${stats_large.std_dev}')
  Stdout.new.print('')
}

fn pub main {
  Stdout.new.print('Inko-Tantivy Performance Benchmarks')
  Stdout.new.print('====================================')
  Stdout.new.print('')

  benchmark_string_conversion(1000, 10)

  benchmark_batch_indexing(100, 10)

  benchmark_search_result_sizes(100, 10)

  cleanup_benchmark_indexes
}
